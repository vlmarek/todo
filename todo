#!/usr/bin/env python3
#
# Personal Todoist command-line helper.
#
# This tool intentionally keeps Todoist as the source of truth.  The local
# cache is a command-time mirror used for matching, listing, and speed.

import argparse
import configparser
import contextlib
import datetime as dt
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import uuid


APP_DIR = os.path.expanduser("~/.todo")
CONFIG_PATH = os.path.join(APP_DIR, "config")
CACHE_PATH = os.path.join(APP_DIR, "cache.json")
CURSOR_PATH = os.path.join(APP_DIR, "report-cursor")
STEP_CONTEXT_PATH = os.path.join(APP_DIR, "step-context.json")
LOCK_PATH = os.path.join(APP_DIR, "lock")

API_BASE = "https://api.todoist.com/api/v1"
SYNC_URL = f"{API_BASE}/sync"

DEFAULT_PROJECT = "Work"
DEFAULT_SECTIONS = ["Operations", "Engineeringing", "Admin", "Someday"]
DEFAULT_HIDDEN_FROM_NOW = ["Someday"]
DEFAULT_WAIT_DAYS = 2
WAITING_LABEL = "waiting"
WAITING_BLOCK_RE = re.compile(r"(?:\n{0,2})\[todo waiting\]\n(.*?)\n\[/todo waiting\]\n?", re.DOTALL)


class TodoError(Exception):
    pass


class TodoUsage(TodoError):
    pass


