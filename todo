  todo task --add Engineering "fix config cleanup"
  todo task --add Operations "deliver next release" "check dashboard" "close build"

due:
  DATE accepts Todoist text, 2d, 4h, 2bd, weekdays such as monday,
  ISO dates/times, clear, or ask for an interactive prompt.
reminder:
  OFFSET is relative to the due time: 0, 10m, 2h, 1d, or "at due".
