def ensure_app_dir():
    os.makedirs(APP_DIR, mode=0o700, exist_ok=True)
    try:
        os.chmod(APP_DIR, 0o700)
    except OSError:
        pass


@contextlib.contextmanager
def lock_state():
    ensure_app_dir()
    with open(LOCK_PATH, "a+", encoding="utf-8") as lockf:
        fcntl.flock(lockf, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lockf, fcntl.LOCK_UN)


def atomic_write(path, data, mode=0o600):
    ensure_app_dir()
    directory = os.path.dirname(path)
    fd, tmp_path = tempfile.mkstemp(prefix=f".{os.path.basename(path)}.", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(data)
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp_path)


def now_utc():
    return dt.datetime.now(dt.timezone.utc)


def iso_utc(value=None):
    value = value or now_utc()
    return value.astimezone(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def parse_iso(value):
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return dt.datetime.fromtimestamp(value, dt.timezone.utc)
    value = str(value)
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    try:
        parsed = dt.datetime.fromisoformat(value)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return parsed.astimezone(dt.timezone.utc)


def today_local():
    return dt.date.today()


def add_business_days(start, days):
    cur = start
    remaining = days
    while remaining > 0:
        cur += dt.timedelta(days=1)
        if cur.weekday() < 5:
            remaining -= 1
    return cur


def normalize_name(value):
    return re.sub(r"[^a-z0-9]+", "", value.lower())


def split_csv(value):
    return [v.strip() for v in value.split(",") if v.strip()]


class Config:
    def __init__(self, parser):
        self.parser = parser

    @classmethod
    def load(cls):
        parser = configparser.ConfigParser()
        if os.path.exists(CONFIG_PATH):
            parser.read(CONFIG_PATH)
        return cls(parser)

    def save_default(self, token=None):
        ensure_app_dir()
        if not self.parser.has_section("todoist"):
            self.parser.add_section("todoist")
        if not self.parser.has_section("main"):
            self.parser.add_section("main")
        if token is not None:
            self.parser.set("todoist", "token", token)
        if not self.parser.has_option("main", "project"):
            self.parser.set("main", "project", DEFAULT_PROJECT)
        if not self.parser.has_option("main", "default_sections"):
            self.parser.set("main", "default_sections", ",".join(DEFAULT_SECTIONS))
        if not self.parser.has_option("main", "hidden_from_now"):
            self.parser.set("main", "hidden_from_now", ",".join(DEFAULT_HIDDEN_FROM_NOW))
        if not self.parser.has_option("main", "wait_days"):
            self.parser.set("main", "wait_days", str(DEFAULT_WAIT_DAYS))
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, dir=APP_DIR,
                                         prefix=".config.") as f:
            self.parser.write(f)
            tmp = f.name
        os.chmod(tmp, 0o600)
        os.replace(tmp, CONFIG_PATH)

    @property
    def token(self):
        return os.environ.get("TODOIST_TOKEN") or self.parser.get("todoist", "token", fallback=None)

    @property
    def project(self):
        return self.parser.get("main", "project", fallback=DEFAULT_PROJECT)

    @property
    def default_sections(self):
        return split_csv(self.parser.get("main", "default_sections", fallback=",".join(DEFAULT_SECTIONS)))

    @property
    def hidden_from_now(self):
        return [normalize_name(s) for s in split_csv(
            self.parser.get("main", "hidden_from_now", fallback=",".join(DEFAULT_HIDDEN_FROM_NOW)))]

    @property
    def wait_days(self):
        return self.parser.getint("main", "wait_days", fallback=DEFAULT_WAIT_DAYS)


class Cache:
    RESOURCE_KEYS = ["projects", "sections", "labels", "items", "notes", "reminders"]

    def __init__(self, data=None):
        self.data = data or self.empty()

    @classmethod
    def empty(cls):
        data = {"sync_token": "*", "synced_at": None, "resource_keys": list(cls.RESOURCE_KEYS)}
        for key in cls.RESOURCE_KEYS:
            data[key] = []
        return data

    @classmethod
    def load(cls):
        if not os.path.exists(CACHE_PATH):
            return cls()
        with open(CACHE_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        if data.get("resource_keys") != cls.RESOURCE_KEYS:
            data["sync_token"] = "*"
            data["resource_keys"] = list(cls.RESOURCE_KEYS)
        for key in cls.RESOURCE_KEYS:
            data.setdefault(key, [])
        return cls(data)

    def save(self):
        atomic_write(CACHE_PATH, json.dumps(self.data, indent=2, sort_keys=True) + "\n")

    def apply_sync(self, response):
        full = bool(response.get("full_sync"))
        for key in self.RESOURCE_KEYS:
            if key not in response:
                continue
            incoming = response.get(key) or []
            if full:
                self.data[key] = incoming
            else:
                self.data[key] = merge_resource(self.data.get(key, []), incoming)
        if response.get("sync_token"):
            self.data["sync_token"] = response["sync_token"]
        self.data["synced_at"] = iso_utc()


def merge_resource(existing, incoming):
    by_id = {str(obj.get("id")): obj for obj in existing if obj.get("id") is not None}
    no_id = [obj for obj in existing if obj.get("id") is None]
    for obj in incoming:
        oid = obj.get("id")
        if oid is None:
            no_id.append(obj)
            continue
        oid = str(oid)
        if obj.get("is_deleted"):
            by_id.pop(oid, None)
        else:
            by_id[oid] = obj
    return no_id + list(by_id.values())


class Todoist:
    def __init__(self, token):
        if not token:
            raise TodoError(f"Todoist token not configured. Run `todo init --token TOKEN` or edit {CONFIG_PATH}.")
        self.token = token

    def request_can_retry(self, method, url):
        method = method.upper()
        return method == "GET" or url == SYNC_URL

    def retry_delay(self, attempt, headers=None):
        if headers:
            retry_after = headers.get("Retry-After")
            if retry_after:
                try:
                    return max(0, min(60, int(retry_after)))
                except ValueError:
                    pass
        return TODOIST_RETRY_DELAYS[min(attempt - 1, len(TODOIST_RETRY_DELAYS) - 1)]

    def warn_retry(self, reason, attempt, delay):
        print(f"todo: warning: Todoist API {reason}; retrying in {delay}s "
              f"(attempt {attempt + 1}/{TODOIST_RETRY_ATTEMPTS}).", file=sys.stderr)

    def request(self, method, url, data=None, form=False):
        headers = {"Authorization": f"Bearer {self.token}"}
        body = None
        if data is not None:
            if form:
                body = urllib.parse.urlencode(data).encode("utf-8")
            else:
                body = json.dumps(data).encode("utf-8")
                headers["Content-Type"] = "application/json"
        can_retry = self.request_can_retry(method, url)
        for attempt in range(1, TODOIST_RETRY_ATTEMPTS + 1):
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            try:
                with urllib.request.urlopen(req, timeout=30) as resp:
                    raw = resp.read().decode("utf-8")
                    return json.loads(raw) if raw else {}
            except urllib.error.HTTPError as e:
                detail = e.read().decode("utf-8", "replace")
                if can_retry and e.code in TODOIST_RETRY_HTTP_CODES and attempt < TODOIST_RETRY_ATTEMPTS:
                    delay = self.retry_delay(attempt, e.headers)
                    self.warn_retry(f"error {e.code}", attempt, delay)
                    time.sleep(delay)
                    continue
                raise TodoError(f"Todoist API error {e.code}: {detail}") from e
            except urllib.error.URLError as e:
                if can_retry and attempt < TODOIST_RETRY_ATTEMPTS:
                    delay = self.retry_delay(attempt)
                    self.warn_retry(f"connection failed: {e.reason}", attempt, delay)
                    time.sleep(delay)
                    continue
                raise TodoError(f"Todoist API connection failed: {e.reason}") from e

    def sync(self, cache, resources=None):
        resources = resources or ["projects", "sections", "labels", "items", "notes", "reminders", "completed_info"]
        response = self.request("POST", SYNC_URL, {
            "sync_token": cache.data.get("sync_token") or "*",
            "resource_types": json.dumps(resources),
        }, form=True)
        cache.apply_sync(response)
        return response

    def command(self, type_, args):
        cmd_uuid = str(uuid.uuid4())
        temp_id = str(uuid.uuid4())
        response = self.request("POST", SYNC_URL, {
            "commands": json.dumps([{
                "type": type_,
                "temp_id": temp_id,
                "uuid": cmd_uuid,
                "args": args,
            }])
        }, form=True)
        status = (response.get("sync_status") or {}).get(cmd_uuid)
        if status != "ok":
            raise TodoError(f"Todoist command {type_} failed: {status}")
        response["_todo_temp_id"] = temp_id
        return response

    def activities(self, since, until, project_id):
        params = {
            "limit": "100",
            "parent_project_id": project_id,
        }
        cursor = None
        out = []
        while True:
            q = dict(params)
            if cursor:
                q["cursor"] = cursor
            url = f"{API_BASE}/activities?{urllib.parse.urlencode(q)}"
            response = self.request("GET", url)
            events = response.get("results") or response.get("events") or []
            if not events:
                break
            out.extend(events)
            oldest = min((event_time(e) for e in events if event_time(e)), default=None)
            if oldest and oldest < since:
                break
            cursor = response.get("next_cursor")
            if not cursor:
                break
        return [e for e in out if since <= (event_time(e) or dt.datetime.min.replace(tzinfo=dt.timezone.utc)) <= until]

    def comments(self, task_id):
        params = {"task_id": str(task_id)}
        out = []
        cursor = None
        while True:
            q = dict(params)
            if cursor:
                q["cursor"] = cursor
            url = f"{API_BASE}/comments?{urllib.parse.urlencode(q)}"
            response = self.request("GET", url)
            if isinstance(response, list):
                out.extend(response)
                break
            out.extend(response.get("results") or response.get("comments") or [])
            cursor = response.get("next_cursor")
            if not cursor:
                break
        return out

    def add_comment(self, task_id, content):
        return self.command("note_add", {
            "item_id": str(task_id),
            "content": content,
        })

    def update_comment(self, comment_id, content):
        return self.command("note_update", {
            "id": str(comment_id),
            "content": content,
        })

    def delete_comment(self, comment_id):
        return self.command("note_delete", {
            "id": str(comment_id),
        })


def live_objects(cache, key):
    return [obj for obj in cache.data.get(key, []) if not obj.get("is_deleted") and not obj.get("is_archived")]


def project_by_name(cache, name):
    wanted = normalize_name(name)
    for project in live_objects(cache, "projects"):
        if normalize_name(project.get("name", "")) == wanted:
            return project
    return None


def waiting_label(cache):
    for label in live_objects(cache, "labels"):
        if normalize_name(label.get("name", "")) == normalize_name(WAITING_LABEL):
            return label
    return None


def root_project(cache, cfg):
    project = project_by_name(cache, cfg.project)
    if not project:
        raise TodoError(f"Project {cfg.project!r} not found. Run `todo init`.")
    return project


def category_projects(cache, project_id):
    return [p for p in live_objects(cache, "projects") if str(p.get("parent_id")) == str(project_id)]


def category_project_by_name(cache, project_id, name):
    wanted = normalize_name(name)
    for project in category_projects(cache, project_id):
        if normalize_name(project.get("name", "")) == wanted:
            return project
    return None


def project_name(cache, project_id):
    for project in live_objects(cache, "projects"):
        if str(project.get("id")) == str(project_id):
            return project.get("name") or "No project"
    return "No project"


def parent_tasks(cache, project_id):
    return [item for item in live_objects(cache, "items")
            if str(item.get("project_id")) == str(project_id)
            and not item.get("parent_id")
            and not item.get("checked")]


def root_project_ids(cache, cfg, include_root=True):
    project = root_project(cache, cfg)
    ids = [str(p.get("id")) for p in category_projects(cache, project.get("id"))]
    if include_root:
        ids.append(str(project.get("id")))
    return ids


def subtasks(cache, task_id):
    return [item for item in live_objects(cache, "items")
            if str(item.get("parent_id")) == str(task_id)
            and not item.get("checked")]


def all_subtasks(cache, task_id):
    return [item for item in live_objects(cache, "items")
            if str(item.get("parent_id")) == str(task_id)]


def notes_for(cache, task_id):
    notes = [n for n in live_objects(cache, "notes") if str(n.get("item_id")) == str(task_id)]
    return sorted(notes, key=lambda n: n.get("posted_at") or n.get("posted") or "")


def reminders_for(cache, task_id):
    reminders = [r for r in live_objects(cache, "reminders")
                 if str(r.get("item_id") or r.get("task_id")) == str(task_id)]
    return sorted(reminders, key=reminder_sort_key)


def reminder_sort_key(reminder):
    due = reminder.get("due") or {}
    return (
        str(reminder.get("type") or ""),
        int(reminder.get("minute_offset") or 0),
        str(due.get("date") or due.get("string") or ""),
    )


def note_time(note):
    return item_time(note, ["posted_at", "posted", "created_at", "updated_at"])


def content_of(obj):
    return obj.get("content") or obj.get("text") or ""


def remove_waiting_block(description):
    return WAITING_BLOCK_RE.sub("\n", description or "").strip()


def set_waiting_block(description, reason, since=None):
    since = since or today_local().isoformat()
    base = remove_waiting_block(description)
    block = "\n".join([
        "[todo waiting]",
        f"Reason: {reason}",
        f"Since: {since}",
        "[/todo waiting]",
    ])
    if base:
        return f"{base}\n\n{block}"
    return block


def waiting_info(task):
    description = task.get("description") or ""
    match = WAITING_BLOCK_RE.search(description)
    if not match:
        return {}
    info = {}
    for line in match.group(1).splitlines():
        key, sep, value = line.partition(":")
        if sep:
            info[key.strip().lower()] = value.strip()
    return info


def waiting_reason(task):
    return waiting_info(task).get("reason", "")


def waiting_age(task, today=None):
    since = waiting_info(task).get("since", "")
    if not since:
        return ""
    since_date = parse_date(since[:10])
    if since_date is None:
        return ""
    days = ((today or today_local()) - since_date).days
    if days < 0:
        return ""
    if days == 0:
        return "today"
    return format_duration(dt.timedelta(days=days))


def waiting_reason_display(task):
    reason = waiting_reason(task)
    if not reason:
        return ""
    age = waiting_age(task)
    if age:
        return f"{reason} ({age})"
    return reason


def load_step_context():
    if not os.path.exists(STEP_CONTEXT_PATH):
        return {}
    try:
        with open(STEP_CONTEXT_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def save_step_context(context):
    atomic_write(STEP_CONTEXT_PATH, json.dumps(context, indent=2, sort_keys=True) + "\n")


def item_by_id(cache):
    return {str(item.get("id")): item for item in live_objects(cache, "items") if item.get("id") is not None}


def top_level_parent(item, items_by_id):
    current = item
    seen = set()
    while current.get("parent_id"):
        parent_id = str(current.get("parent_id"))
        if parent_id in seen:
            break
        seen.add(parent_id)
        parent = items_by_id.get(parent_id)
        if not parent:
            break
        current = parent
    return current


def build_step_context(cache, existing=None, seen_at=None):
    context = dict(existing or {})
    seen_at = seen_at or iso_utc()
    items_by_id = item_by_id(cache)
    for item in items_by_id.values():
        direct_parent_id = str(item.get("parent_id") or "")
        step_id = str(item.get("id") or "")
        if not direct_parent_id or not step_id:
            continue
        direct_parent = items_by_id.get(direct_parent_id)
        parent = top_level_parent(item, items_by_id)
        project_id = str(parent.get("project_id") or item.get("project_id") or "")
        context[step_id] = {
            "step_id": step_id,
            "step_title_last_seen": content_of(item),
            "direct_parent_id": direct_parent_id,
            "direct_parent_title_last_seen": content_of(direct_parent or {}),
            "parent_task_id": str(parent.get("id") or ""),
            "parent_title_last_seen": content_of(parent),
            "project_id_last_seen": project_id,
            "category_last_seen": project_name(cache, project_id),
            "last_seen_at": seen_at,
        }
    return context


def refresh_step_context(cache):
    save_step_context(build_step_context(cache, load_step_context()))


def cli_priority_to_api(value):
    value = int(value)
    if value < 1 or value > 4:
        raise TodoError("Priority must be 1, 2, 3, or 4.")
    return 5 - value


def api_priority_to_cli(value):
    try:
        value = int(value)
    except (TypeError, ValueError):
        value = 1
    return 5 - value


def set_color_mode(mode):
    global COLOR_MODE
    COLOR_MODE = mode


def color_enabled(stream=None):
    stream = stream or sys.stdout
    if COLOR_MODE == "never":
        return False
    if COLOR_MODE == "always":
        return True
    if os.environ.get("NO_COLOR") is not None:
        return False
    if os.environ.get("TERM") == "dumb":
        return False
    return hasattr(stream, "isatty") and stream.isatty()


def colorize(text, color, bold=False, dim=False):
    text = str(text)
    if not color_enabled():
        return text
    r, g, b = SOLARIZED[color]
    attrs = []
    if bold:
        attrs.append("1")
    if dim:
        attrs.append("2")
    attrs.append(f"38;2;{r};{g};{b}")
    return f"\033[{';'.join(attrs)}m{text}\033[0m"


def clear_screen_if_terminal(stream=None):
    stream = stream or sys.stdout
    if hasattr(stream, "isatty") and stream.isatty():
        print("\033[H\033[J", end="", file=stream)


def format_priority(item):
    priority = api_priority_to_cli(item.get("priority"))
    text = f"P{priority}"
    if priority == 1:
        return colorize(text, "red", bold=True)
    if priority == 2:
        return colorize(text, "yellow")
    if priority == 3:
        return colorize(text, "blue")
    return colorize(text, "base01", dim=True)


def format_due_display(due):
    if not due:
        return ""
    if "overdue" in due:
        return colorize(due, "red", bold=True)
    if due.startswith("due:today"):
        return colorize(due, "yellow", bold=True)
    if due.startswith("due:tomorrow"):
        return colorize(due, "base1")
    if " left" in due or due.startswith("due:in "):
        return colorize(due, "cyan")
    return due


def format_reminder_offset(minutes):
    try:
        minutes = int(minutes)
    except (TypeError, ValueError):
        return ""
    if minutes == 0:
        return "at due"
    days, rem = divmod(minutes, 1440)
    hours, rem = divmod(rem, 60)
    parts = []
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if rem:
        parts.append(f"{rem}m")
    return f"{' '.join(parts)} before" if parts else "before"


def parse_reminder_offset(value):
    text = str(value or "").strip().lower()
    if text in ("0", "0m", "due", "at due", "on due"):
        return 0
    if re.fullmatch(r"\d+", text):
        return int(text)
    total = 0
    pos = 0
    matched = False
    for match in re.finditer(r"(\d+)\s*([dhm])", text):
        if text[pos:match.start()].strip():
            raise TodoError(f"Cannot parse reminder offset {value!r}. Use 0, 10m, 2h, 1d, or 'at due'.")
        amount = int(match.group(1))
        unit = match.group(2)
        if unit == "d":
            total += amount * 1440
        elif unit == "h":
            total += amount * 60
        else:
            total += amount
        pos = match.end()
        matched = True
    if matched and not text[pos:].strip():
        return total
    raise TodoError(f"Cannot parse reminder offset {value!r}. Use 0, 10m, 2h, 1d, or 'at due'.")


def parse_reminder_offsets(values):
    return [parse_reminder_offset(value) for value in values or []]


def format_reminder(reminder):
    if reminder.get("type") == "relative":
        text = format_reminder_offset(reminder.get("minute_offset"))
        return text or "relative"
    due = reminder.get("due") or {}
    raw = due.get("date") or due.get("string")
    if raw:
        return f"at {format_due_value_for_display(raw)}"
    return str(reminder.get("type") or "reminder")


def format_reminders(cache, task_id):
    values = [format_reminder(reminder) for reminder in reminders_for(cache, task_id)]
    values = [value for value in values if value]
    if not values:
        return ""
    label = "reminders" if len(values) != 1 else "reminder"
    return f"{label}:{', '.join(values)}"


def format_reminders_display(text):
    return colorize(text, "cyan") if text else ""


def format_waiting_marker(text="waiting"):
    return colorize(text, "magenta")


def format_step_mark(checked):
    return colorize("[x]", "green") if checked else colorize("[ ]", "base01", dim=True)


def format_task_state_display(state):
    normalized = str(state).strip()
    if normalized == "open":
        return colorize(state, "blue")
    if normalized == "waiting":
        return colorize(state, "magenta")
    if normalized == "done":
        return colorize(state, "green")
    return state


def labels_of(item):
    labels = item.get("labels") or []
    return [str(label) for label in labels]


def has_waiting(item):
    return any(normalize_name(label) == normalize_name(WAITING_LABEL) for label in labels_of(item))


def due_date(item):
    due = item.get("due") or {}
    return due.get("date") or due.get("datetime") or due.get("string")


def due_day(item):
    due = due_when(item)
    if isinstance(due, dt.datetime):
        return due.astimezone().date()
    if isinstance(due, dt.date):
        return due
    raw = due_date(item)
    if raw:
        try:
            return dt.date.fromisoformat(raw[:10])
        except ValueError:
            return None
    return None


def waiting_due_now(item):
    if not has_waiting(item):
        return False
    day = due_day(item)
    return bool(day and day <= today_local())


def due_when(item):
    due = item.get("due") or {}
    if due.get("datetime"):
        parsed = parse_iso(due.get("datetime"))
        if parsed:
            return parsed
    if due.get("date"):
        value = due.get("date")
        if "T" in value:
            if value.endswith("Z"):
                value = value[:-1] + "+00:00"
            try:
                parsed = dt.datetime.fromisoformat(value)
            except ValueError:
                return None
            if parsed.tzinfo is None:
                parsed = parsed.astimezone()
            return parsed.astimezone(dt.timezone.utc)
        try:
            return dt.date.fromisoformat(value)
        except ValueError:
            return None
    return None


def recurrence_suffix(item):
    due = item.get("due") or {}
    if not due.get("is_recurring"):
        return ""
    value = (due.get("string") or "").strip()
    if not value:
        return " ↻"
    value = re.sub(r"\s+starting(?:\s+from)?\s+.+$", "", value, flags=re.IGNORECASE).strip()
    return f" ↻ {value}" if value else " ↻"


def format_due(item):
    when = due_when(item)
    raw = due_date(item)
    recurring = recurrence_suffix(item)
    if when is None:
        return f"due:{raw}{recurring}" if raw else recurring.strip()
    if isinstance(when, dt.datetime):
        delta = when - now_utc()
        suffix = "left"
        if delta.total_seconds() < 0:
            delta = -delta
            suffix = "overdue"
        return f"due:{format_duration(delta)} {suffix}{recurring}"
    today = today_local()
    days = (when - today).days
    if days < 0:
        return f"due:{abs(days)}d overdue{recurring}"
    if days == 0:
        return f"due:today{recurring}"
    if days == 1:
        return f"due:tomorrow{recurring}"
    return f"due:in {days}d{recurring}"


def format_duration(delta):
    seconds = max(0, int(delta.total_seconds()))
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes = rem // 60
    if days:
        if hours:
            return f"{days}d {hours}h"
        return f"{days}d"
    if hours:
        if minutes:
            return f"{hours}h {minutes}m"
        return f"{hours}h"
    return f"{minutes}m"


def item_time(item, names):
    for name in names:
        if item.get(name):
            parsed = parse_iso(item.get(name))
            if parsed:
                return parsed
    return None


def event_time(event):
    return item_time(event, ["event_date", "event_date_utc", "time", "date", "created_at"])


def is_hidden_category(cache, cfg, item):
    name = project_name(cache, item.get("project_id"))
    return normalize_name(name) in cfg.hidden_from_now


def match_text(cache, task):
    parts = [content_of(task), task.get("description") or ""]
    for child in all_subtasks(cache, task.get("id")):
        parts.append(content_of(child))
    return "\n".join(parts).lower()


def resolve_task(cache, cfg, selector, include_completed=False):
    project_ids = set(root_project_ids(cache, cfg))
    tasks = [item for item in live_objects(cache, "items")
             if str(item.get("project_id")) in project_ids
             and not item.get("parent_id")]
    if not include_completed:
        tasks = [t for t in tasks if not t.get("checked")]
    candidates = []
    selector_norm = selector.lower()

    exact_id = [t for t in tasks if str(t.get("id")) == selector]
    if len(exact_id) == 1:
        return exact_id[0]

    for task in tasks:
        haystack = match_text(cache, task)
        if selector_norm in haystack:
            candidates.append(task)

    if not candidates:
        raise TodoError(f"No task matches {selector!r}.")
    if len(candidates) == 1:
        return candidates[0]
    return choose_task(cache, cfg, selector, candidates)


def choose_task(cache, cfg, selector, candidates):
    candidates = sorted(candidates, key=lambda t: (
        has_waiting(t),
        is_hidden_category(cache, cfg, t),
        -int(t.get("priority") or 1),
        content_of(t).lower(),
    ))
    if not sys.stdin.isatty():
        print_candidates(cache, candidates, f"Multiple tasks match {selector!r}:")
        raise TodoError("Refusing to choose a task in non-interactive mode.")
    print_candidates(cache, candidates, f"Multiple tasks match {selector!r}:")
    answer = input("Select task number, or Enter to cancel: ").strip()
    if not answer:
        raise TodoError("Cancelled.")
    try:
        index = int(answer)
    except ValueError as e:
        raise TodoError("Selection must be a number.") from e
    if index < 1 or index > len(candidates):
        raise TodoError("Selection out of range.")
    return candidates[index - 1]


def print_candidates(cache, candidates, header):
    print(header)
    print()
    for i, task in enumerate(candidates, 1):
        print(f"{i:2d}  {format_priority(task)}  "
              f"{project_name(cache, task.get('project_id')):<12} {content_of(task)}")
    print()


def item_candidate_text(cache, candidate):
    task = candidate["task"]
    if candidate["kind"] == "task":
        state = "done" if task.get("checked") else "open"
        return (f"{candidate['kind']:<4} {state:<4} "
                f"{format_priority(task)}  {project_name(cache, task.get('project_id')):<12} "
                f"{content_of(task)}")
    step = candidate["step"]
    state = "done" if step.get("checked") else "open"
    return (f"{candidate['kind']:<4} {state:<4} "
            f"{format_priority(task)}  {project_name(cache, task.get('project_id')):<12} "
            f"{content_of(task)} / {content_of(step)}")


def print_item_candidates(cache, candidates, header):
    print(header)
    print()
    for i, candidate in enumerate(candidates, 1):
        print(f"{i:2d}  {item_candidate_text(cache, candidate)}")
    print()


def choose_item(cache, selector, candidates):
    if not sys.stdin.isatty():
        print_item_candidates(cache, candidates, f"Multiple items match {selector!r}:")
        raise TodoError("Refusing to choose an item in non-interactive mode.")
    print_item_candidates(cache, candidates, f"Multiple items match {selector!r}:")
    answer = input("Select item number, or Enter to cancel: ").strip()
    if not answer:
        raise TodoError("Cancelled.")
    try:
        index = int(answer)
    except ValueError as e:
        raise TodoError("Selection must be a number.") from e
    if index < 1 or index > len(candidates):
        raise TodoError("Selection out of range.")
    return candidates[index - 1]


def resolve_task_or_step(cache, cfg, selector, include_completed=False):
    project_ids = set(root_project_ids(cache, cfg))
    tasks = [item for item in live_objects(cache, "items")
             if str(item.get("project_id")) in project_ids
             and not item.get("parent_id")]
    tasks_by_id = {str(task.get("id")): task for task in tasks}
    steps = [item for item in live_objects(cache, "items")
             if str(item.get("parent_id")) in tasks_by_id]
    if not include_completed:
        tasks = [task for task in tasks if not task.get("checked")]
        live_task_ids = {str(task.get("id")) for task in tasks}
        steps = [step for step in steps
                 if str(step.get("parent_id")) in live_task_ids
                 and not step.get("checked")]
    exact = []
    for task in tasks:
        if str(task.get("id")) == selector:
            exact.append({"kind": "task", "task": task})
    for step in steps:
        if str(step.get("id")) == selector:
            exact.append({"kind": "step", "task": tasks_by_id[str(step.get("parent_id"))], "step": step})
    if len(exact) == 1:
        return exact[0]

    selector_norm = selector.lower()
    candidates = []
    for task in tasks:
        if selector_norm in content_of(task).lower():
            candidates.append({"kind": "task", "task": task})
    for step in steps:
        if selector_norm in content_of(step).lower():
            candidates.append({"kind": "step", "task": tasks_by_id[str(step.get("parent_id"))], "step": step})
    candidates = sorted(candidates, key=lambda candidate: (
        bool((candidate.get("step") or candidate["task"]).get("checked")),
        has_waiting(candidate["task"]),
        is_hidden_category(cache, cfg, candidate["task"]),
        0 if candidate["kind"] == "task" else 1,
        project_name(cache, candidate["task"].get("project_id")).lower(),
        content_of(candidate["task"]).lower(),
        content_of(candidate.get("step") or {}).lower(),
    ))
    if not candidates:
        raise TodoError(f"No task or step matches {selector!r}.")
    if len(candidates) == 1:
        return candidates[0]
    return choose_item(cache, selector, candidates)


def require_project_and_category(cache, cfg, category):
    project = root_project(cache, cfg)
    category_project = category_project_by_name(cache, project.get("id"), category)
    if not category_project:
        available = ", ".join(p.get("name", "") for p in category_projects(cache, project.get("id")))
        raise TodoError(f"Category {category!r} not found under {cfg.project!r}. Available: {available}")
    return project, category_project


def sync_or_fail(client, cache):
    client.sync(cache)
    refresh_step_context(cache)
    cache.save()


def sync_readonly(client, cache):
    try:
        client.sync(cache)
        refresh_step_context(cache)
        cache.save()
        return True
    except TodoError as e:
        if not os.path.exists(CACHE_PATH):
            raise
        print(f"Warning: {e}", file=sys.stderr)
        print(f"Warning: showing stale cache from {cache.data.get('synced_at')}", file=sys.stderr)
        return False


def mutate(client, cache, type_, args):
    response = client.command(type_, args)
    # Command responses carry sync_status and may carry a new sync_token without
    # carrying the changed resource objects.  Keep the old token until the
    # follow-up sync has fetched and merged those objects, otherwise the local
    # mirror can skip the command's own changes.
    client.sync(cache)
    refresh_step_context(cache)
    cache.save()
    return response


def mapped_id(response):
    temp_id = response.get("_todo_temp_id")
    if not temp_id:
        return None
    mapping = response.get("temp_id_mapping") or {}
    return mapping.get(temp_id)


def add_note(client, cache, task_id, content):
    mutate(client, cache, "note_add", {"item_id": str(task_id), "content": content})


def update_item(client, cache, task_id, **kwargs):
    args = {"id": str(task_id)}
    args.update(kwargs)
    mutate(client, cache, "item_update", args)


def close_item(client, cache, task_id):
    mutate(client, cache, "item_close", {"id": str(task_id)})


def reopen_item(client, cache, task_id):
    mutate(client, cache, "item_uncomplete", {"id": str(task_id)})


def delete_item(client, cache, task_id):
    mutate(client, cache, "item_delete", {"id": str(task_id)})


def cached_item(cache, item_id):
    return item_by_id(cache).get(str(item_id))


def item_has_due_time(item):
    due = (item or {}).get("due") or {}
    if due.get("datetime"):
        return True
    value = due.get("date") or ""
    return "T" in value


def add_relative_reminders(client, cache, item_id, offsets):
    offsets = parse_reminder_offsets(offsets)
    if not offsets:
        return
    item = cached_item(cache, item_id)
    if not item_has_due_time(item):
        raise TodoError("Relative reminders need a due date with time. "
                        "Set one with --due, for example `--due \"tomorrow 10:00\"`.")
    existing = {int(reminder.get("minute_offset") or 0)
                for reminder in reminders_for(cache, item_id)
                if reminder.get("type") == "relative"}
    for offset in offsets:
        label = format_reminder_offset(offset)
        if offset in existing:
            print(f"Reminder already exists: {label}")
            continue
        mutate(client, cache, "reminder_add", {
            "item_id": str(item_id),
            "type": "relative",
            "minute_offset": offset,
        })
        existing.add(offset)
        print(f"Added reminder: {label}")


def cmd_init(args):
    with lock_state():
        cfg = Config.load()
        cfg.save_default(token=args.token)
        if not args.token and not cfg.token:
            print(f"Wrote {CONFIG_PATH}. Add your Todoist token with `todo init --token TOKEN`.")
            return 0
        client = Todoist(cfg.token)
        cache = Cache.load()
        sync_or_fail(client, cache)
        project = project_by_name(cache, cfg.project)
        if not project:
            mutate(client, cache, "project_add", {"name": cfg.project})
            project = project_by_name(cache, cfg.project)
        if not project:
            raise TodoError(f"Failed to create or find project {cfg.project!r}.")
        for name in cfg.default_sections:
            if not category_project_by_name(cache, project.get("id"), name):
                mutate(client, cache, "project_add", {"name": name, "parent_id": str(project.get("id"))})
        if not waiting_label(cache):
            mutate(client, cache, "label_add", {"name": WAITING_LABEL})
        print(f"Initialized Todoist project {cfg.project!r}.")
        print(f"Config: {CONFIG_PATH}")
        print(f"Cache:  {CACHE_PATH}")
        return 0


def cmd_category(args):
    with lock_state():
        if args.add:
            cfg, client, cache = load_runtime()
            sync_or_fail(client, cache)
        else:
            cfg, cache = load_cached_runtime(args.refresh)
        project = root_project(cache, cfg)
        if args.add:
            if category_project_by_name(cache, project.get("id"), args.add):
                print(f"Category {args.add!r} already exists.")
                return 0
            mutate(client, cache, "project_add", {"name": args.add, "parent_id": str(project.get("id"))})
            print(f"Created category {args.add}.")
            return 0
        for cat in sorted(category_projects(cache, project.get("id")), key=lambda p: p.get("child_order") or 0):
            marker = " (hidden from now)" if normalize_name(cat.get("name", "")) in cfg.hidden_from_now else ""
            print(f"{cat.get('name')}{marker}")
        return 0


def cmd_add(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        _, category_project = require_project_and_category(cache, cfg, args.category)
        due_value = resolve_due_value(args.due) if args.due else None
        item_args = {
            "content": args.task,
            "project_id": str(category_project.get("id")),
        }
        if args.priority:
            item_args["priority"] = cli_priority_to_api(args.priority)
        if due_value:
            item_args["due"] = {"string": due_value}
        response = mutate(client, cache, "item_add", item_args)
        task_id = mapped_id(response) or find_added_task_id(cache, category_project.get("id"), args.task)
        if (args.steps or getattr(args, "done", False)) and not task_id:
            raise TodoError("Added task, but could not find its Todoist ID.")
        if getattr(args, "reminders", None):
            if not task_id:
                raise TodoError("Added task, but could not find its Todoist ID to add reminders.")
            if getattr(args, "done", False):
                raise TodoError("Use --reminder only for open tasks.")
            add_relative_reminders(client, cache, task_id, args.reminders)
        if getattr(args, "done", False):
            print(f"Added done task: {args.task}")
        else:
            print(f"Added: {args.task}")
        for step in args.steps:
            response = mutate(client, cache, "item_add", {
                "content": step,
                "project_id": str(category_project.get("id")),
                "parent_id": str(task_id),
            })
            step_id = mapped_id(response) or find_added_step_id(cache, task_id, step)
            if getattr(args, "done", False):
                if not step_id:
                    raise TodoError(f"Added step {step!r}, but could not find its Todoist ID to mark it done.")
                close_item(client, cache, step_id)
                print(f"Added done step: {step}")
            else:
                print(f"Added step: {step}")
        if getattr(args, "done", False):
            close_item(client, cache, task_id)
        return 0


def find_added_task_id(cache, project_id, content):
    matches = [item for item in live_objects(cache, "items")
               if str(item.get("project_id")) == str(project_id)
               and not item.get("parent_id")
               and content_of(item) == content
               and not item.get("checked")]
    if len(matches) == 1:
        return str(matches[0].get("id"))
    return None


def find_added_step_id(cache, task_id, content):
    matches = [item for item in live_objects(cache, "items")
               if str(item.get("parent_id")) == str(task_id)
               and content_of(item) == content
               and not item.get("checked")]
    if len(matches) == 1:
        return str(matches[0].get("id"))
    return None


def cmd_step(args):
    with lock_state():
        if args.steps:
            cfg, client, cache = load_runtime()
            sync_or_fail(client, cache)
        else:
            cfg, cache = load_cached_runtime(args.refresh)
        task = resolve_task(cache, cfg, args.task)
        if not args.steps:
            print_steps(cache, task)
            return 0
        due_value = resolve_due_value(args.due) if getattr(args, "due", None) else None
        for step in args.steps:
            item_args = {
                "content": step,
                "project_id": str(task.get("project_id")),
                "parent_id": str(task.get("id")),
            }
            if due_value:
                item_args["due"] = {"string": due_value}
            response = mutate(client, cache, "item_add", item_args)
            step_id = mapped_id(response) or find_added_step_id(cache, task.get("id"), step)
            if getattr(args, "reminders", None):
                if not step_id:
                    raise TodoError(f"Added step {step!r}, but could not find its Todoist ID to add reminders.")
                if getattr(args, "done", False):
                    raise TodoError("Use --reminder only for open steps.")
                add_relative_reminders(client, cache, step_id, args.reminders)
            if getattr(args, "done", False):
                if not step_id:
                    raise TodoError(f"Added step {step!r}, but could not find its Todoist ID to mark it done.")
                close_item(client, cache, step_id)
                print(f"Added done step: {step}")
            else:
                print(f"Added step: {step}")
        return 0


def cmd_show(args):
    with lock_state():
        cfg, cache = load_cached_runtime(args.refresh)
        task = resolve_task(cache, cfg, args.task)
        comments = notes_for(cache, task.get("id"))
        print_task_detail(cache, task, comments=comments)
        return 0


def print_task_detail(cache, task, comments=None):
    waiting = f" {format_waiting_marker()}" if has_waiting(task) else ""
    due = format_due(task)
    due_text = format_due_display(due) if due else colorize("none", "base01", dim=True)
    task_reminders = reminders_for(cache, task.get("id"))
    reminder_summary = ", ".join(format_reminder(reminder) for reminder in task_reminders)
    print(f"{format_priority(task)}  {project_name(cache, task.get('project_id'))}  {content_of(task)}{waiting}")
    print(f"Due: {due_text}")
    if reminder_summary:
        print(f"Reminders: {format_reminders_display(reminder_summary)}")
    description = remove_waiting_block(task.get("description") or "")
    if description:
        print()
        print("Description")
        print(description)
    if task_reminders:
        print()
        print("Reminders")
        for reminder in task_reminders:
            print(f"- {format_reminder(reminder)}")
    print()
    print("Steps")
    children = all_subtasks(cache, task.get("id"))
    if not children:
        print("- None")
    else:
        for child in children:
            due = format_due(child)
            due_text = f" {format_due_display(due)}" if due else ""
            reminder = format_reminders(cache, child.get("id"))
            reminder_text = f" {format_reminders_display(reminder)}" if reminder else ""
            print(f"- {format_step_mark(child.get('checked'))} {content_of(child)}{due_text}{reminder_text}")
    print()
    print("Comments")
    notes = comments if comments is not None else notes_for(cache, task.get("id"))
    print_comments(notes)


def format_note_time(value):
    local = value.astimezone()
    return local.strftime("%Y-%m-%d %H:%M")


def print_comments(comments):
    if not comments:
        print("- None")
        return
    for note in sorted(comments, key=lambda n: n.get("posted_at") or n.get("posted") or n.get("created_at") or ""):
        when = note_time(note)
        stamp = format_note_time(when) if when else "unknown"
        print(f"- {stamp}  {content_of(note)}")


def latest_comment(comments):
    if not comments:
        return None
    return sorted(comments, key=lambda n: n.get("posted_at") or n.get("posted") or n.get("created_at") or "")[-1]


def edit_text(initial):
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    ensure_app_dir()
    fd, path = tempfile.mkstemp(prefix="comment.", suffix=".txt", dir=APP_DIR)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(initial)
            if initial and not initial.endswith("\n"):
                f.write("\n")
        result = subprocess.run([editor, path])
        if result.returncode != 0:
            raise TodoError(f"Editor exited with status {result.returncode}.")
        with open(path, "r", encoding="utf-8") as f:
            return f.read().rstrip("\n")
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)


COMMENT_HEADER_RE = re.compile(r"^\[id: ([^ ]+) posted: (.*)\]$")
NEW_COMMENT_RE = re.compile(r"^\[new\]$")


def render_comments_edit_buffer(task_title, comments):
    lines = [
        f"# todo comments for: {task_title}",
        "# Edit comment bodies below.",
        "# Delete a whole [id: ...] header to merge that block into the previous comment.",
        "# Delete a header and its body to delete that comment.",
        "# Add one or more [new] blocks to create new comments.",
        "",
    ]
    for comment in sorted(comments, key=lambda n: n.get("posted_at") or n.get("posted") or n.get("created_at") or ""):
        when = note_time(comment)
        posted = format_note_time(when) if when else "unknown"
        lines.append(f"[id: {comment.get('id')} posted: {posted}]")
        lines.extend(content_of(comment).splitlines())
        lines.append("")
    lines.append("[new]")
    return "\n".join(lines).rstrip() + "\n"


def parse_comments_edit_buffer(text):
    blocks = []
    current = None
    for line in text.splitlines():
        header = COMMENT_HEADER_RE.match(line)
        if header:
            if current is not None:
                blocks.append(current)
            current = {"kind": "existing", "id": header.group(1), "lines": []}
            continue
        if NEW_COMMENT_RE.match(line):
            if current is not None:
                blocks.append(current)
            current = {"kind": "new", "id": None, "lines": []}
            continue
        if current is None:
            continue
        current["lines"].append(line)
    if current is not None:
        blocks.append(current)
    return [(block["kind"], block["id"], trim_comment_body(block["lines"])) for block in blocks]


def trim_comment_body(lines):
    end = len(lines)
    while end > 0 and lines[end - 1] == "":
        end -= 1
    return "\n".join(lines[:end])


def apply_comments_edit(client, task_id, old_comments, edited_text):
    old_by_id = {str(comment.get("id")): content_of(comment) for comment in old_comments}
    seen_ids = set()
    updated = deleted = created = 0
    for kind, comment_id, body in parse_comments_edit_buffer(edited_text):
        if kind == "new":
            if body.strip():
                client.add_comment(task_id, body)
                created += 1
            continue
        seen_ids.add(comment_id)
        if not body.strip():
            client.delete_comment(comment_id)
            deleted += 1
        elif old_by_id.get(comment_id) != body:
            client.update_comment(comment_id, body)
            updated += 1
    for comment_id in old_by_id:
        if comment_id not in seen_ids:
            client.delete_comment(comment_id)
            deleted += 1
    return {"updated": updated, "deleted": deleted, "created": created}


def format_comment_edit_summary(counts):
    parts = []
    for key in ("updated", "deleted", "created"):
        value = counts.get(key, 0)
        if value:
            parts.append(f"{value} {key}")
    return ", ".join(parts) if parts else "no changes"


def print_steps(cache, task):
    print(f"Task: {content_of(task)}")
    print()
    children = all_subtasks(cache, task.get("id"))
    if not children:
        print("No steps.")
        return
    for i, child in enumerate(children, 1):
        due = format_due(child)
        due_text = f" {format_due_display(due)}" if due else ""
        reminder = format_reminders(cache, child.get("id"))
        reminder_text = f" {format_reminders_display(reminder)}" if reminder else ""
        print(f"{i:2d}  {format_step_mark(child.get('checked'))} {content_of(child)}{due_text}{reminder_text}")


def resolve_step(cache, task, selector):
    children = all_subtasks(cache, task.get("id"))
    if not children:
        raise TodoError("Task has no steps.")
    if re.fullmatch(r"\d+", selector):
        index = int(selector)
        if 1 <= index <= len(children):
            return children[index - 1]
        raise TodoError("Step number out of range.")
    matches = [child for child in children if selector.lower() in content_of(child).lower()]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise TodoError(f"No step matches {selector!r}.")
    if not sys.stdin.isatty():
        raise TodoError(f"Multiple steps match {selector!r}; run `todo step TASK` and use a number.")
    print(f"Multiple steps match {selector!r}:")
    print()
    for i, child in enumerate(matches, 1):
        print(f"{i:2d}  {format_step_mark(child.get('checked'))} {content_of(child)}")
    print()
    answer = input("Select step number, or Enter to cancel: ").strip()
    if not answer:
        raise TodoError("Cancelled.")
    index = int(answer)
    if index < 1 or index > len(matches):
        raise TodoError("Selection out of range.")
    return matches[index - 1]


def complete_step_item(client, cache, step):
    if step.get("checked"):
        print(f"Step already done: {content_of(step)}")
        return
    close_item(client, cache, step.get("id"))
    print(f"Done step: {content_of(step)}")


def cmd_check(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        step = resolve_step(cache, task, args.step)
        complete_step_item(client, cache, step)
        return 0


def cmd_comment(args):
    with lock_state():
        if not args.edit and not args.texts:
            cfg, cache = load_cached_runtime(args.refresh)
            task = resolve_task(cache, cfg, args.task)
            print(f"Comments for: {content_of(task)}")
            print_comments(notes_for(cache, task.get("id")))
            return 0
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        if args.edit:
            comments = client.comments(task.get("id"))
            old_text = render_comments_edit_buffer(content_of(task), comments)
            new_text = edit_text(old_text)
            if new_text == old_text.rstrip("\n"):
                print("Comment unchanged.")
                return 0
            counts = apply_comments_edit(client, task.get("id"), comments, new_text)
            client.sync(cache)
            cache.save()
            print(f"Edited comments on {content_of(task)}: {format_comment_edit_summary(counts)}.")
            return 0
        if args.texts:
            add_task_comments(client, task.get("id"), args.texts)
            client.sync(cache)
            cache.save()
            count = len(args.texts)
            plural = "s" if count != 1 else ""
            print(f"Added {count} comment{plural} to: {content_of(task)}")
            return 0
        raise TodoError("Unknown comment mode.")


def add_task_comments(client, task_id, texts):
    for text in texts:
        client.add_comment(task_id, text)


def cmd_wait(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        follow_date = wait_follow_date(args, cfg)
        follow_display = format_due_value_for_display(follow_date)
        existing_due = due_date(task)
        if existing_due and not args.yes:
            existing_display = format_due_value_for_display(existing_due)
            answer = input(f"Existing due date is {existing_display}. "
                           f"Replace with waiting follow-up {follow_display}? [y/N] ").strip()
            if answer.lower() not in ("y", "yes"):
                raise TodoError("Cancelled.")
        labels = labels_of(task)
        if not any(normalize_name(label) == normalize_name(WAITING_LABEL) for label in labels):
            labels.append(WAITING_LABEL)
        update_item(client, cache, task.get("id"),
                    labels=labels,
                    due={"string": follow_date},
                    description=set_waiting_block(task.get("description") or "", args.text))
        print(f"Waiting until {follow_display}: {content_of(task)}")
        print(f"Reason: {args.text}")
        return 0


def wait_follow_date(args, cfg):
    if getattr(args, "due", None):
        due = resolve_due_value(args.due)
        if due is None:
            raise TodoError("Waiting tasks need a follow-up due date; use `todo task --resume` to clear waiting.")
        return due
    return compute_after(args.after, cfg.wait_days).isoformat()


def compute_after(after, default_days):
    if not after:
        return add_business_days(today_local(), default_days)
    value = after.strip().lower()
    if value in ("tomorrow", "1d", "1 day"):
        return today_local() + dt.timedelta(days=1)
    if value in ("2 business days", "2bd", "2 business day"):
        return add_business_days(today_local(), 2)
    m = re.fullmatch(r"(\d+)\s*(d|day|days)", value)
    if m:
        return today_local() + dt.timedelta(days=int(m.group(1)))
    m = re.fullmatch(r"(\d+)\s*(bd|business days?|businessdays?)", value)
    if m:
        return add_business_days(today_local(), int(m.group(1)))
    parsed = parse_date(value)
    if parsed:
        return parsed
    raise TodoError(f"Cannot parse --after value {after!r}. Use e.g. '2 business days', '5d', or YYYY-MM-DD.")


def parse_date(value):
    try:
        return dt.date.fromisoformat(value)
    except ValueError:
        return None


class DueParseResult:
    def __init__(self, value, preview):
        self.value = value
        self.preview = preview


INVALID_DUE = object()


def localize_datetime(date_value, time_value):
    return dt.datetime.combine(date_value, time_value).astimezone().replace(microsecond=0)


def parse_due_time(value):
    m = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?", value.strip())
    if not m:
        return None
    hour = int(m.group(1))
    minute = int(m.group(2) or 0)
    if hour > 23 or minute > 59:
        return None
    return dt.time(hour, minute)


def due_result(value):
    return DueParseResult(value, format_due_value_for_display(value))


def parse_due_value_local(value, now=None):
    now = (now or dt.datetime.now().astimezone()).astimezone()
    stripped = value.strip()
    lowered = stripped.lower()
    if lowered in ("none", "clear", "-"):
        return DueParseResult(None, "remove due date")

    m = re.fullmatch(r"(\d+)\s*(bd|business\s*days?|businessdays?)", lowered)
    if m:
        target_date = add_business_days(now.date(), int(m.group(1)))
        target = localize_datetime(target_date, now.timetz().replace(tzinfo=None))
        return due_result(target.isoformat())

    m = re.fullmatch(r"(\d+)\s*([dh])", lowered)
    if m:
        amount = int(m.group(1))
        unit = m.group(2)
        if unit == "h":
            target = now + dt.timedelta(hours=amount)
        else:
            target_date = now.date() + dt.timedelta(days=amount)
            target = localize_datetime(target_date, now.timetz().replace(tzinfo=None))
        return due_result(target.replace(microsecond=0).isoformat())

    parsed_date = parse_date(stripped)
    if parsed_date:
        return due_result(parsed_date.isoformat())

    m = re.fullmatch(r"(\d{4}-\d{2}-\d{2})[ t](\d{1,2}(?::\d{2})?)", stripped)
    if m:
        parsed_date = parse_date(m.group(1))
        parsed_time = parse_due_time(m.group(2))
        if parsed_date and parsed_time:
            return due_result(localize_datetime(parsed_date, parsed_time).isoformat())
        return INVALID_DUE

    m = re.fullmatch(r"(today|tomorrow)(?:\s+(\d{1,2}(?::\d{2})?))?", lowered)
    if m:
        target_date = now.date()
        if m.group(1) == "tomorrow":
            target_date += dt.timedelta(days=1)
        if not m.group(2):
            return due_result(target_date.isoformat())
        parsed_time = parse_due_time(m.group(2))
        if parsed_time:
            return due_result(localize_datetime(target_date, parsed_time).isoformat())
        return INVALID_DUE

    m = re.fullmatch(r"([a-z]+)(?:\s+(\d{1,2}(?::\d{2})?))?", lowered)
    if m and m.group(1) in WEEKDAYS:
        target_weekday = WEEKDAYS[m.group(1)]
        days = (target_weekday - now.weekday()) % 7
        if days == 0:
            days = 7
        target_date = now.date() + dt.timedelta(days=days)
        if not m.group(2):
            return due_result(target_date.isoformat())
        parsed_time = parse_due_time(m.group(2))
        if parsed_time:
            return due_result(localize_datetime(target_date, parsed_time).isoformat())
        return INVALID_DUE

    return INVALID_DUE


def normalize_due_value(value):
    result = parse_due_value_local(value)
    if result is INVALID_DUE:
        return value.strip()
    return result.value


def ask_due_value():
    if not sys.stdin.isatty():
        raise TodoError("--due ask requires an interactive terminal.")
    current = input("Due date: ").strip()
    while True:
        if not current:
            print(DUE_EXAMPLES)
            current = input("Due date: ").strip()
            continue
        result = parse_due_value_local(current)
        if result is INVALID_DUE:
            print(f"Could not parse {current!r}.")
            print(DUE_EXAMPLES)
            current = input("Due date: ").strip()
            continue
        print(f"Interpreted as: {result.preview}")
        answer = input("Use this? [Y/n/new due] ").strip()
        if not answer or answer.lower() in ("y", "yes"):
            return result.value
        if answer.lower() in ("n", "no"):
            raise TodoError("Cancelled.")
        current = answer


def resolve_due_value(value):
    if value.strip().lower() == "ask":
        return ask_due_value()
    return normalize_due_value(value)


def cmd_resume(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        labels = [label for label in labels_of(task) if normalize_name(label) != normalize_name(WAITING_LABEL)]
        update_item(client, cache, task.get("id"),
                    labels=labels,
                    due=None,
                    description=remove_waiting_block(task.get("description") or ""))
        print(f"Resumed: {content_of(task)}")
        return 0


def complete_task_item(client, cache, task, text=None):
    if task.get("checked"):
        print(f"Task already done: {content_of(task)}")
        return
    open_steps = subtasks(cache, task.get("id"))
    if open_steps:
        print("Open steps:")
        for i, child in enumerate(open_steps, 1):
            print(f"{i:2d}  {format_step_mark(False)} {content_of(child)}")
        print()
        answer = input("Mark all open steps done and complete parent task? [y/N] ").strip()
        if answer.lower() not in ("y", "yes"):
            raise TodoError("Cancelled; task left open.")
        for child in open_steps:
            close_item(client, cache, child.get("id"))
    if text:
        add_note(client, cache, task.get("id"), f"Done: {text}")
    close_item(client, cache, task.get("id"))
    print(f"Done: {content_of(task)}")


def cmd_done(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        complete_task_item(client, cache, task, args.text)
        return 0


def cmd_undone(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task, include_completed=True)
        if not task.get("checked"):
            print(f"Already open: {content_of(task)}")
            return 0
        reopen_item(client, cache, task.get("id"))
        print(f"Reopened: {content_of(task)}")
        return 0


def cmd_step_undone(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task, include_completed=True)
        step = resolve_step(cache, task, args.step)
        if not step.get("checked"):
            print(f"Step already open: {content_of(step)}")
            return 0
        reopen_item(client, cache, step.get("id"))
        print(f"Reopened step: {content_of(step)}")
        return 0


def confirm_delete(kind, title, yes=False):
    if yes:
        return
    if not sys.stdin.isatty():
        raise TodoError("Use --yes to delete non-interactively.")
    answer = input(f"Delete {kind}: {title}? [y/N] ").strip().lower()
    if answer not in ("y", "yes"):
        raise TodoError("Cancelled; nothing deleted.")


def delete_task_item(client, cache, task):
    was_done = bool(task.get("checked"))
    if was_done:
        reopen_item(client, cache, task.get("id"))
    delete_item(client, cache, task.get("id"))
    return was_done


def cmd_delete_task(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task, include_completed=True)
        confirm_delete("task", content_of(task), args.yes)
        was_done = delete_task_item(client, cache, task)
        state = "completed task" if was_done else "task"
        print(f"Deleted {state}: {content_of(task)}")
        return 0


def delete_step_item(client, cache, task, step):
    parent_was_done = bool(task.get("checked"))
    step_was_done = bool(step.get("checked"))
    if parent_was_done:
        reopen_item(client, cache, task.get("id"))
    if step_was_done:
        reopen_item(client, cache, step.get("id"))
    delete_item(client, cache, step.get("id"))
    if parent_was_done:
        close_item(client, cache, task.get("id"))
    return parent_was_done, step_was_done


def cmd_delete_step(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task, include_completed=True)
        step = resolve_step(cache, task, args.step)
        confirm_delete("step", f"{content_of(task)} / {content_of(step)}", args.yes)
        parent_was_done, step_was_done = delete_step_item(client, cache, task, step)
        state = "completed step" if step_was_done else "step"
        if parent_was_done:
            state = f"{state} from completed task"
        print(f"Deleted {state}: {content_of(step)}")
        return 0


def cmd_priority(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        update_item(client, cache, task.get("id"), priority=cli_priority_to_api(args.priority))
        print(f"P{args.priority}: {content_of(task)}")
        return 0


def cmd_due(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        due_value = resolve_due_value(args.date)
        if due_value is None:
            if getattr(args, "reminders", None):
                raise TodoError("Cannot add reminders after clearing the due date.")
            update_item(client, cache, task.get("id"), due=None)
            print(f"Cleared due date: {content_of(task)}")
        else:
            update_item(client, cache, task.get("id"), due={"string": due_value})
            if getattr(args, "reminders", None):
                add_relative_reminders(client, cache, task.get("id"), args.reminders)
            print(f"Due {format_due_value_for_display(due_value)}: {content_of(task)}")
        return 0


def cmd_task_reminder(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        add_relative_reminders(client, cache, task.get("id"), args.reminders)
        return 0


def cmd_step_reminder(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task)
        step = resolve_step(cache, task, args.step)
        add_relative_reminders(client, cache, step.get("id"), args.reminders)
        return 0


def format_due_value_for_display(value):
    parsed_date = parse_date(value)
    if parsed_date:
        relative = format_due({"due": {"date": parsed_date.isoformat()}})
        if relative:
            return f"{parsed_date.isoformat()} ({relative})"
        return parsed_date.isoformat()
    parsed = parse_iso(value)
    if not parsed:
        return value
    local = parsed.astimezone().strftime("%Y-%m-%d %H:%M")
    relative = format_due({"due": {"date": value}})
    if relative:
        return f"{local} ({relative})"
    return local


def move_task_to_project(client, cache, task, category_project):
    was_done = bool(task.get("checked"))
    if was_done:
        reopen_item(client, cache, task.get("id"))
    mutate(client, cache, "item_move", {
        "id": str(task.get("id")),
        "project_id": str(category_project.get("id")),
    })
    if was_done:
        close_item(client, cache, task.get("id"))
    return was_done


def rename_task_item(client, cache, task, new_name):
    was_done = bool(task.get("checked"))
    if was_done:
        reopen_item(client, cache, task.get("id"))
    update_item(client, cache, task.get("id"), content=new_name)
    if was_done:
        close_item(client, cache, task.get("id"))
    return was_done


def cmd_rename_task(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task, include_completed=True)
        old_name = content_of(task)
        was_done = rename_task_item(client, cache, task, args.new_name)
        state = "completed task" if was_done else "task"
        print(f"Renamed {state}: {old_name} -> {args.new_name}")
        return 0


def rename_step_item(client, cache, task, step, new_name):
    parent_was_done = bool(task.get("checked"))
    step_was_done = bool(step.get("checked"))
    if parent_was_done:
        reopen_item(client, cache, task.get("id"))
    if step_was_done:
        reopen_item(client, cache, step.get("id"))
    update_item(client, cache, step.get("id"), content=new_name)
    if step_was_done:
        close_item(client, cache, step.get("id"))
    if parent_was_done:
        close_item(client, cache, task.get("id"))
    return parent_was_done, step_was_done


def cmd_rename_step(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task, include_completed=True)
        step = resolve_step(cache, task, args.step)
        old_name = content_of(step)
        parent_was_done, step_was_done = rename_step_item(client, cache, task, step, args.new_name)
        state = "completed step" if step_was_done else "step"
        if parent_was_done:
            state = f"{state} from completed task"
        print(f"Renamed {state}: {old_name} -> {args.new_name}")
        return 0


def cmd_rename_any(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        target = resolve_task_or_step(cache, cfg, args.item, include_completed=True)
        if target["kind"] == "task":
            task = target["task"]
            old_name = content_of(task)
            was_done = rename_task_item(client, cache, task, args.new_name)
            state = "completed task" if was_done else "task"
            print(f"Renamed {state}: {old_name} -> {args.new_name}")
            return 0
        task = target["task"]
        step = target["step"]
        old_name = content_of(step)
        parent_was_done, step_was_done = rename_step_item(client, cache, task, step, args.new_name)
        state = "completed step" if step_was_done else "step"
        if parent_was_done:
            state = f"{state} from completed task"
        print(f"Renamed {state}: {old_name} -> {args.new_name}")
        return 0


def cmd_done_any(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        target = resolve_task_or_step(cache, cfg, args.item, include_completed=True)
        if target["kind"] == "task":
            complete_task_item(client, cache, target["task"], args.text)
            return 0
        if args.text:
            raise TodoError("Completion text is only supported for tasks.")
        complete_step_item(client, cache, target["step"])
        return 0


def cmd_unclose_any(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        target = resolve_task_or_step(cache, cfg, args.item, include_completed=True)
        if target["kind"] == "task":
            task = target["task"]
            if not task.get("checked"):
                print(f"Already open: {content_of(task)}")
                return 0
            reopen_item(client, cache, task.get("id"))
            print(f"Reopened: {content_of(task)}")
            return 0
        step = target["step"]
        if not step.get("checked"):
            print(f"Step already open: {content_of(step)}")
            return 0
        reopen_item(client, cache, step.get("id"))
        print(f"Reopened step: {content_of(step)}")
        return 0


def cmd_delete_any(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        target = resolve_task_or_step(cache, cfg, args.item, include_completed=True)
        if target["kind"] == "task":
            task = target["task"]
            confirm_delete("task", content_of(task), args.yes)
            was_done = delete_task_item(client, cache, task)
            state = "completed task" if was_done else "task"
            print(f"Deleted {state}: {content_of(task)}")
            return 0
        task = target["task"]
        step = target["step"]
        confirm_delete("step", f"{content_of(task)} / {content_of(step)}", args.yes)
        parent_was_done, step_was_done = delete_step_item(client, cache, task, step)
        state = "completed step" if step_was_done else "step"
        if parent_was_done:
            state = f"{state} from completed task"
        print(f"Deleted {state}: {content_of(step)}")
        return 0


def cmd_move(args):
    with lock_state():
        cfg, client, cache = load_runtime()
        sync_or_fail(client, cache)
        task = resolve_task(cache, cfg, args.task, include_completed=True)
        _, category_project = require_project_and_category(cache, cfg, args.category)
        was_done = move_task_to_project(client, cache, task, category_project)
        state = "completed task" if was_done else "task"
        print(f"Moved {state} to {category_project.get('name')}: {content_of(task)}")
        return 0


def selected_modes(args, names):
    return [name for name in names if getattr(args, name)]


def require_arg_count(command, values, minimum, maximum=None, usage=None):
    usage = usage if usage is not None else MODE_USAGE.get(command)
    maximum = minimum if maximum is None else maximum
    count = len(values)
    if count < minimum or count > maximum:
        if count < minimum and usage:
            raise TodoUsage(usage)
        if minimum == maximum:
            expected = str(minimum)
        else:
            expected = f"{minimum}-{maximum}"
        raise TodoError(f"`todo {command}` expected {expected} argument(s), got {count}.")


def parse_priority_args(values):
    task, priority_text = values
    if re.fullmatch(r"[1-4]", task) and not re.fullmatch(r"[1-4]", priority_text):
        raise TodoError(
            "`todo task --priority` expects TASK P. It looks like the priority came first; "
            f"use `todo task --priority {priority_text} {task}`."
        )
    try:
        priority = int(priority_text)
    except ValueError as e:
        raise TodoError("`todo task --priority` expects priority P as 1, 2, 3, or 4: "
                        "todo task --priority TASK P.") from e
    cli_priority_to_api(priority)
    return task, priority


def due_option_value(args, command):
    due = getattr(args, "due", None)
    if due is True:
        raise TodoError(f"`todo {command}` expects DATE after --due.")
    return due


def task_due_mode_values(args):
    values = []
    if args.due is not True:
        values.append(args.due)
    values.extend(args.values)
    require_arg_count("task --due", values, 2)
    return values[0], values[1]


def cmd_task(args):
    modes = selected_modes(args, [
        "add", "done", "undone", "delete", "wait", "resume", "due",
        "reminder", "priority", "move", "rename", "comment", "step"])
    mode_set = set(modes)
    add_priority = getattr(args, "add_priority", None)
    if "add" in mode_set:
        if not mode_set <= {"add", "done", "due", "reminder"}:
            raise TodoError("Use only one task mode at a time.")
        mode = "add_done" if "done" in mode_set else "add"
    elif "wait" in mode_set:
        if not mode_set <= {"wait", "due"}:
            raise TodoError("Use only one task mode at a time.")
        mode = "wait"
    elif "due" in mode_set:
        if not mode_set <= {"due", "reminder"}:
            raise TodoError("Use only one task mode at a time.")
        mode = "due"
    elif len(modes) > 1:
        raise TodoError("Use only one task mode at a time.")
    else:
        mode = modes[0] if modes else "show"
    if add_priority is not None and mode == "show":
        mode = "priority_shortcut"
    values = args.values
    add_due = due_option_value(args, "task --add") if "add" in mode_set and "due" in mode_set else None
    wait_due = due_option_value(args, "task --wait") if mode == "wait" and "due" in mode_set else None
    reminder_offsets = args.reminder or []
    if add_priority is not None and mode not in ("add", "add_done", "priority_shortcut"):
        raise TodoError("Use -p1, -p2, -p3, or -p4 only with `todo task --add` or `todo task -pN TASK`.")
    if args.yes and mode != "delete":
        raise TodoError("Use --yes only with `todo task --delete`.")
    if args.refresh and mode != "show":
        raise TodoError("Use --refresh only with `todo task TASK`; mutation modes refresh automatically.")
    if reminder_offsets and mode not in ("add", "add_done", "due", "reminder"):
        raise TodoError("Use --reminder only with `todo task --add`, `todo task --due`, or `todo task --reminder`.")
    if reminder_offsets and mode == "add_done":
        raise TodoError("Use --reminder only for open tasks.")
    if mode == "show":
        require_arg_count("task", values, 1)
        return cmd_show(argparse.Namespace(task=values[0], refresh=args.refresh))
    if mode == "add":
        require_arg_count("task --add", values, 2, 9999, usage=TASK_ADD_USAGE)
        return cmd_add(argparse.Namespace(
            category=values[0],
            task=values[1],
            steps=values[2:],
            priority=add_priority,
            due=add_due,
            reminders=reminder_offsets,
            done=False,
        ))
    if mode == "add_done":
        require_arg_count("task --add --done", values, 2, 9999)
        return cmd_add(argparse.Namespace(
            category=values[0],
            task=values[1],
            steps=values[2:],
            priority=add_priority,
            due=add_due,
            reminders=reminder_offsets,
            done=True,
        ))
    if mode == "done":
        require_arg_count("task --done", values, 1, 2)
        return cmd_done(argparse.Namespace(task=values[0], text=values[1] if len(values) == 2 else None))
    if mode == "undone":
        require_arg_count("task --undone", values, 1)
        return cmd_undone(argparse.Namespace(task=values[0]))
    if mode == "delete":
        require_arg_count("task --delete", values, 1)
        return cmd_delete_task(argparse.Namespace(task=values[0], yes=args.yes))
    if mode == "wait":
        require_arg_count("task --wait", values, 2)
        return cmd_wait(argparse.Namespace(task=values[0], text=values[1], after=None, due=wait_due, yes=False))
    if mode == "resume":
        require_arg_count("task --resume", values, 2)
        return cmd_resume(argparse.Namespace(task=values[0], text=values[1]))
    if mode == "due":
        task, date = task_due_mode_values(args)
        return cmd_due(argparse.Namespace(task=task, date=date, reminders=reminder_offsets))
    if mode == "reminder":
        require_arg_count("task --reminder", values, 1)
        return cmd_task_reminder(argparse.Namespace(task=values[0], reminders=reminder_offsets))
    if mode == "priority":
        require_arg_count("task --priority", values, 2)
        task, priority = parse_priority_args(values)
        return cmd_priority(argparse.Namespace(task=task, priority=priority))
    if mode == "priority_shortcut":
        require_arg_count("task --priority", values, 1)
        return cmd_priority(argparse.Namespace(task=values[0], priority=add_priority))
    if mode == "move":
        require_arg_count("task --move", values, 2)
        return cmd_move(argparse.Namespace(task=values[0], category=values[1]))
    if mode == "rename":
        require_arg_count("task --rename", values, 2)
        return cmd_rename_task(argparse.Namespace(task=values[0], new_name=values[1]))
    if mode == "comment":
        require_arg_count("task --comment", values, 2, 9999)
        return cmd_comment_noun(argparse.Namespace(add=True, edit=False, refresh=False, values=values))
    if mode == "step":
        require_arg_count("task --step", values, 2, 9999)
        return cmd_step_noun(argparse.Namespace(
            add=True, done=False, undone=False, delete=False, due=None,
            reminder=[], yes=False, refresh=False, values=values))
    raise TodoError(f"Unknown task mode {mode}.")


def cmd_step_noun(args):
    modes = selected_modes(args, ["add", "done", "undone", "delete", "due", "reminder", "rename"])
    mode_set = set(modes)
    if "due" in mode_set and "add" not in mode_set:
        raise TodoError("Use --due only with `todo step --add`.")
    if "reminder" in mode_set and "add" not in mode_set and len(mode_set) > 1:
        raise TodoError("Use only one step mode at a time.")
    if "add" in mode_set:
        if not mode_set <= {"add", "done", "due", "reminder"}:
            raise TodoError("Use only one step mode at a time.")
        mode = "add_done" if "done" in mode_set else "add"
    elif len(modes) > 1:
        raise TodoError("Use only one step mode at a time.")
    else:
        mode = modes[0] if modes else "show"
    values = args.values
    add_due = due_option_value(args, "step --add") if "due" in mode_set else None
    reminder_offsets = args.reminder or []
    if args.yes and mode != "delete":
        raise TodoError("Use --yes only with `todo step --delete`.")
    if args.refresh and mode != "show":
        raise TodoError("Use --refresh only with `todo step TASK`; mutation modes refresh automatically.")
    if reminder_offsets and mode not in ("add", "add_done", "reminder"):
        raise TodoError("Use --reminder only with `todo step --add` or `todo step --reminder`.")
    if reminder_offsets and mode == "add_done":
        raise TodoError("Use --reminder only for open steps.")
    if mode == "show":
        require_arg_count("step", values, 1)
        return cmd_step(argparse.Namespace(task=values[0], steps=[], due=None, reminders=[], refresh=args.refresh))
    if mode == "add":
        require_arg_count("step --add", values, 2, 9999)
        return cmd_step(argparse.Namespace(task=values[0], steps=values[1:], done=False, due=add_due,
                                           reminders=reminder_offsets))
    if mode == "add_done":
        require_arg_count("step --add --done", values, 2, 9999)
        return cmd_step(argparse.Namespace(task=values[0], steps=values[1:], done=True, due=add_due,
                                           reminders=reminder_offsets))
    if mode == "done":
        require_arg_count("step --done", values, 2)
        return cmd_check(argparse.Namespace(task=values[0], step=values[1]))
    if mode == "undone":
        require_arg_count("step --undone", values, 2)
        return cmd_step_undone(argparse.Namespace(task=values[0], step=values[1]))
    if mode == "delete":
        require_arg_count("step --delete", values, 2)
        return cmd_delete_step(argparse.Namespace(task=values[0], step=values[1], yes=args.yes))
    if mode == "rename":
        require_arg_count("step --rename", values, 3)
        return cmd_rename_step(argparse.Namespace(task=values[0], step=values[1], new_name=values[2]))
    if mode == "reminder":
        require_arg_count("step --reminder", values, 2)
        return cmd_step_reminder(argparse.Namespace(task=values[0], step=values[1], reminders=reminder_offsets))
    raise TodoError(f"Unknown step mode {mode}.")


def cmd_comment_noun(args):
    modes = selected_modes(args, ["add", "edit"])
    if len(modes) > 1:
        raise TodoError("Use only one comment mode at a time.")
    mode = modes[0] if modes else "show"
    values = args.values
    if args.refresh and mode != "show":
        raise TodoError("Use --refresh only with `todo comment TASK`; mutation modes refresh automatically.")
    if mode == "show":
        if len(values) > 1:
            if args.refresh:
                raise TodoError("Use --refresh only with `todo comment TASK`; mutation modes refresh automatically.")
            return cmd_comment(argparse.Namespace(task=values[0], texts=values[1:], edit=False, refresh=False))
        require_arg_count("comment", values, 1)
        return cmd_comment(argparse.Namespace(task=values[0], texts=[], edit=False, refresh=args.refresh))
    if mode == "add":
        require_arg_count("comment --add", values, 2, 9999)
        return cmd_comment(argparse.Namespace(task=values[0], texts=values[1:], edit=False, refresh=False))
    if mode == "edit":
        require_arg_count("comment --edit", values, 1)
        return cmd_comment(argparse.Namespace(task=values[0], texts=[], edit=True, refresh=False))
    raise TodoError(f"Unknown comment mode {mode}.")


def cmd_rename_shortcut(args):
    require_arg_count("rename", args.values, 2)
    return cmd_rename_any(argparse.Namespace(item=args.values[0], new_name=args.values[1]))


def cmd_done_shortcut(args):
    require_arg_count("done", args.values, 1, 2)
    return cmd_done_any(argparse.Namespace(
        item=args.values[0],
        text=args.values[1] if len(args.values) == 2 else None,
    ))


def cmd_unclose_shortcut(args):
    require_arg_count("unclose", args.values, 1)
    return cmd_unclose_any(argparse.Namespace(item=args.values[0]))


def cmd_delete_shortcut(args):
    require_arg_count("delete", args.values, 1)
    return cmd_delete_any(argparse.Namespace(item=args.values[0], yes=args.yes))


def cmd_wait_shortcut(args):
    due = due_option_value(args, "wait") if args.due is not None else None
    require_arg_count("wait", args.values, 2)
    return cmd_wait(argparse.Namespace(task=args.values[0], text=args.values[1], after=None, due=due, yes=False))


def cmd_move_shortcut(args):
    require_arg_count("move", args.values, 2)
    return cmd_move(argparse.Namespace(task=args.values[0], category=args.values[1]))


def cmd_priority_shortcut(args):
    require_arg_count("priority", args.values, 2)
    task, priority = parse_priority_args(args.values)
    return cmd_priority(argparse.Namespace(task=task, priority=priority))


def compact_text(text, limit=120):
    text = re.sub(r"\s+", " ", str(text or "")).strip()
    if len(text) <= limit:
        return text
    return text[:limit - 3].rstrip() + "..."


def matching_line(text, query):
    query_norm = query.lower()
    for line in str(text or "").splitlines():
        if query_norm in line.lower():
            return compact_text(line)
    return compact_text(text)


def task_state(task):
    if task.get("checked"):
        return "done"
    if has_waiting(task):
        return "waiting"
    return "open"


def task_search_matches(cache, task, query, comments=None):
    query_norm = query.lower()
    matches = []
    title = content_of(task)
    if query_norm in title.lower():
        matches.append("task title")
    description = remove_waiting_block(task.get("description") or "")
    if query_norm in description.lower():
        matches.append(f"description: {matching_line(description, query)}")
    reason = waiting_reason(task)
    if reason and query_norm in reason.lower():
        matches.append(f"waiting reason: {compact_text(reason)}")
    for step in all_subtasks(cache, task.get("id")):
        text = content_of(step)
        if query_norm in text.lower():
            state = "done" if step.get("checked") else "open"
            matches.append(f"step {state}: {compact_text(text)}")
    for comment in comments or []:
        text = content_of(comment)
        if query_norm not in text.lower():
            continue
        when = note_time(comment)
        stamp = f" {format_note_time(when)}" if when else ""
        matches.append(f"comment{stamp}: {matching_line(text, query)}")
    return matches


def step_context_search_results(cache, active_tasks_by_id, step_context, query, seen_step_ids):
    query_norm = query.lower()
    results = []
    for step_id, context in sorted((step_context or {}).items()):
        if step_id in seen_step_ids:
            continue
        step_title = context.get("step_title_last_seen") or ""
        parent_title = context.get("parent_title_last_seen") or context.get("parent_task_id") or "Unknown task"
        if query_norm not in step_title.lower() and query_norm not in parent_title.lower():
            continue
        parent_task_id = str(context.get("parent_task_id") or "")
        task = active_tasks_by_id.get(parent_task_id) or {
            "id": parent_task_id,
            "content": parent_title,
            "project_id": context.get("project_id_last_seen"),
            "checked": True,
            "priority": 1,
        }
        if query_norm in parent_title.lower():
            matches = ["task title"]
            if query_norm in step_title.lower():
                matches.append(f"step done: {compact_text(step_title)}")
        else:
            matches = [f"step done: {compact_text(step_title)}"]
        results.append({"task": task, "matches": matches})
    return results


def search_results(cache, project_ids, query, comments_by_task=None, step_context=None):
    tasks = [item for item in live_objects(cache, "items")
             if str(item.get("project_id")) in project_ids
             and not item.get("parent_id")]
    comments_by_task = comments_by_task or cached_comments_by_task(cache, tasks)
    active_tasks_by_id = {str(task.get("id")): task for task in tasks}
    results = []
    for task in tasks:
        matches = task_search_matches(cache, task, query, comments_by_task.get(str(task.get("id")), []))
        if matches:
            results.append({"task": task, "matches": matches})
    seen_step_ids = {str(step.get("id")) for task in tasks for step in all_subtasks(cache, task.get("id"))}
    results.extend(step_context_search_results(cache, active_tasks_by_id, step_context or {}, query, seen_step_ids))
    return sorted(results, key=lambda r: search_sort_key(cache, r["task"]))


def cached_comments_by_task(cache, tasks):
    return {str(task.get("id")): notes_for(cache, task.get("id")) for task in tasks}


def search_sort_key(cache, task):
    state_rank = {"open": 0, "waiting": 1, "done": 2}.get(task_state(task), 3)
    due = due_date(task) or "9999-99-99"
    return (
        state_rank,
        -int(task.get("priority") or 1),
        due,
        project_name(cache, task.get("project_id")).lower(),
        content_of(task).lower(),
    )


def print_search_results(cache, results):
    if not results:
        print("No matches.")
        return
    for result in results:
        task = result["task"]
        state = task_state(task)
        state_text = format_task_state_display(f"{state:<7}")
        print(f"{format_priority(task)}  "
              f"{project_name(cache, task.get('project_id')):<12} {state_text} {content_of(task)}")
        for match in result["matches"]:
            print(f"    {match}")


def cmd_search(args):
    query = " ".join(args.values).strip()
    if not query:
        raise TodoUsage(SEARCH_USAGE)
    with lock_state():
        cfg = Config.load()
        cache = Cache.load()
        if args.refresh:
            client = Todoist(cfg.token)
            sync_readonly(client, cache)
        project_ids = set(root_project_ids(cache, cfg))
        tasks = [item for item in live_objects(cache, "items")
                 if str(item.get("project_id")) in project_ids
                 and not item.get("parent_id")]
        comments_by_task = cached_comments_by_task(cache, tasks)
        print_search_results(cache, search_results(cache, project_ids, query, comments_by_task, load_step_context()))
        return 0


def cmd_now(args):
    with lock_state():
        cfg, cache = load_cached_runtime(args.refresh)
        project = root_project(cache, cfg)
        active_project_ids = {str(p.get("id")) for p in category_projects(cache, project.get("id"))
                              if normalize_name(p.get("name", "")) not in cfg.hidden_from_now}
        tasks = []
        for task in [item for item in live_objects(cache, "items")
                     if str(item.get("project_id")) in active_project_ids
                     and not item.get("parent_id")
                     and not item.get("checked")]:
            if has_waiting(task) and not waiting_due_now(task):
                continue
            if args.category and normalize_name(project_name(cache, task.get("project_id"))) != normalize_name(args.category):
                continue
            tasks.append(task)
        tasks = sort_now(cache, tasks)
        clear_screen_if_terminal()
        print_task_list(cache, tasks, show_steps=True)
        return 0


def sort_now(cache, tasks):
    today = today_local().isoformat()

    def key(task):
        due = effective_due_date_for_sort(cache, task)
        overdue_rank = 0
        if due:
            due_day = due[:10]
            if due_day < today:
                overdue_rank = -2
            elif due_day == today:
                overdue_rank = -1
        return (
            overdue_rank,
            -int(task.get("priority") or 1),
            due or "9999-99-99",
            project_name(cache, task.get("project_id")).lower(),
            content_of(task).lower(),
        )
    return sorted(tasks, key=key)


def effective_due_date_for_sort(cache, task):
    due_values = []
    due = due_date(task)
    if due:
        due_values.append(due)
    for step in subtasks(cache, task.get("id")):
        due = due_date(step)
        if due:
            due_values.append(due)
    return min(due_values) if due_values else None


def print_task_list(cache, tasks, show_steps=False):
    if not tasks:
        print("No tasks.")
        return
    for task in tasks:
        due = format_due(task)
        due_text = f" {format_due_display(due)}" if due else ""
        reminder = format_reminders(cache, task.get("id"))
        reminder_text = f" {format_reminders_display(reminder)}" if reminder else ""
        waiting = f" {format_waiting_marker()}" if has_waiting(task) else ""
        print(f"{format_priority(task)}  "
              f"{project_name(cache, task.get('project_id')):<12} {content_of(task)}{due_text}{reminder_text}{waiting}")
        reason = waiting_reason_display(task)
        if reason:
            print(f"    {reason}")
        if show_steps:
            steps = subtasks(cache, task.get("id"))
            for step in steps:
                step_due = format_due(step)
                step_due_text = f" {format_due_display(step_due)}" if step_due else ""
                step_reminder = format_reminders(cache, step.get("id"))
                step_reminder_text = f" {format_reminders_display(step_reminder)}" if step_reminder else ""
                print(f"    - {content_of(step)}{step_due_text}{step_reminder_text}")


def cmd_waiting(args):
    with lock_state():
        cfg, cache = load_cached_runtime(args.refresh)
        project_ids = set(root_project_ids(cache, cfg, include_root=False))
        tasks = []
        for task in [item for item in live_objects(cache, "items")
                     if str(item.get("project_id")) in project_ids
                     and not item.get("parent_id")
                     and not item.get("checked")]:
            if not has_waiting(task):
                continue
            tasks.append(task)
        print_task_list(cache, sort_now(cache, tasks), show_steps=True)
        return 0


def cmd_someday(args):
    with lock_state():
        cfg, cache = load_cached_runtime(args.refresh)
        project_ids = set(root_project_ids(cache, cfg, include_root=False))
        hidden = set(cfg.hidden_from_now)
        tasks = [task for task in live_objects(cache, "items")
                 if str(task.get("project_id")) in project_ids
                 and not task.get("parent_id")
                 and not task.get("checked")
                 and normalize_name(project_name(cache, task.get("project_id"))) in hidden]
        print_task_list(cache, sort_now(cache, tasks), show_steps=True)
        return 0


def cmd_report(args):
    with lock_state():
        cfg, client, cache = load_runtime(readonly=True)
        sync_readonly(client, cache)
        project = root_project(cache, cfg)
        since = report_since(args)
        until = parse_iso(args.until) if args.until else now_utc()
        if until is None:
            raise TodoError(f"Cannot parse --until {args.until!r}.")
        events = []
        try:
            events = client.activities(since, until, str(project.get("id")))
        except TodoError as e:
            print(f"Warning: activity lookup failed: {e}", file=sys.stderr)
        report_comments = {}

        def fetch_report_comments(task_id):
            task_id = str(task_id)
            if not task_id:
                return []
            if task_id not in report_comments:
                try:
                    report_comments[task_id] = client.comments(task_id)
                except TodoError as e:
                    print(f"Warning: comment lookup failed for {task_id}: {e}", file=sys.stderr)
                    report_comments[task_id] = []
            return report_comments[task_id]

        report = build_report(
            cache, set(root_project_ids(cache, cfg)), since, until, events,
            load_step_context(), fetch_report_comments)
        print(report)
        if args.final:
            atomic_write(CURSOR_PATH, iso_utc(until) + "\n")
            print(f"\nAdvanced report cursor to {iso_utc(until)}", file=sys.stderr)
        return 0


def report_since(args):
    if args.since:
        parsed = parse_iso(args.since)
        if not parsed:
            raise TodoError(f"Cannot parse --since {args.since!r}.")
        return parsed
    if os.path.exists(CURSOR_PATH):
        with open(CURSOR_PATH, "r", encoding="utf-8") as f:
            parsed = parse_iso(f.read().strip())
            if parsed:
                return parsed
    return current_wednesday_start()


def current_wednesday_start():
    today = today_local()
    days_since_wed = (today.weekday() - 2) % 7
    wed = today - dt.timedelta(days=days_since_wed)
    local_start = dt.datetime.combine(wed, dt.time.min).astimezone()
    return local_start.astimezone(dt.timezone.utc)


def build_report(cache, project_ids, since, until, events, step_context=None, comment_fetcher=None):
    by_id = {str(item.get("id")): item for item in live_objects(cache, "items")
             if str(item.get("project_id")) in project_ids}
    event_context = report_event_context(cache, events)
    step_context = step_context or {}
    sections = {"Finished": {}, "Progress": {}, "Waiting": {}}

    for event in sorted(events, key=lambda e: event_time(e) or since):
        if skip_report_event(event, since, until):
            continue
        if event.get("object_type") == "note":
            continue
        task_id = event_task_id(event)
        text = activity_text(event)
        kind = classify_activity(event, text)
        if kind not in sections:
            continue
        if kind == "Finished" and task_id in step_context:
            context = step_context[task_id]
            title, category, detail = completed_step_report_entry(cache, by_id, context, text)
            section = "Progress" if completed_step_parent_is_open(by_id, context) else "Finished"
            if section == "Progress" and detail.startswith("Step done: "):
                detail = detail[len("Step done: "):]
            comments = sections[section].setdefault(category, {}).setdefault(title, [])
            if detail not in comments:
                comments.append(detail)
            if section == "Finished":
                append_report_comments(comments, comment_fetcher, context.get("parent_task_id"))
            continue
        task = by_id.get(task_id) or synthetic_task_from_event(event)
        context = event_context.get(task_id, {})
        title = context.get("title") or content_of(task) or event.get("object_name") or event.get("extra_data", {}).get("content") or task_id
        category = context.get("category") or report_category(cache, task, event)
        comments = sections[kind].setdefault(category, {}).setdefault(title, [])
        if text and text != title:
            comments.append(text)
        if kind == "Finished":
            append_report_comments(comments, comment_fetcher, task_id)

    for task in by_id.values():
        if task.get("checked") or not has_waiting(task):
            continue
        title = content_of(task)
        category = project_name(cache, task.get("project_id"))
        category_items = sections["Waiting"].setdefault(category, {})
        if title not in category_items:
            details = []
            reason = waiting_reason_display(task)
            if reason:
                details.append(reason)
            category_items[title] = details

    lines = [f"Report {iso_utc(since)} -> {iso_utc(until)}", ""]
    for name in ("Finished", "Progress", "Waiting"):
        lines.append(name)
        if not sections[name]:
            lines.append("- None")
        else:
            for category, items in sections[name].items():
                lines.append(f"{category}")
                for title, comments in items.items():
                    lines.append(f"- {title}")
                    for comment in comments:
                        append_report_detail(lines, comment)
        lines.append("")
    return "\n".join(lines).rstrip()


def append_report_comments(details, comment_fetcher, task_id):
    if comment_fetcher is None or not task_id:
        return
    for comment in comment_fetcher(task_id):
        text = content_of(comment)
        if text:
            details.append(text)


def append_report_detail(lines, detail):
    detail_lines = str(detail).splitlines() or [""]
    lines.append(f"  - {detail_lines[0]}")
    for line in detail_lines[1:]:
        lines.append(f"    {line}")


def completed_step_report_entry(cache, active_tasks_by_id, context, fallback_text):
    parent_task_id = str(context.get("parent_task_id") or "")
    parent = active_tasks_by_id.get(parent_task_id)
    if parent:
        title = content_of(parent)
        category = project_name(cache, parent.get("project_id"))
    else:
        title = context.get("parent_title_last_seen") or parent_task_id or "Unknown task"
        category = context.get("category_last_seen") or "Unknown"
    step_title = context.get("step_title_last_seen") or fallback_text
    return title, category, f"Step done: {step_title}"


def completed_step_parent_is_open(active_tasks_by_id, context):
    parent_task_id = str(context.get("parent_task_id") or "")
    return bool(parent_task_id and parent_task_id in active_tasks_by_id)


def report_event_context(cache, events):
    context = {}
    for event in sorted(events, key=lambda e: event_time(e) or dt.datetime.min.replace(tzinfo=dt.timezone.utc)):
        if event.get("object_type") != "item":
            continue
        task_id = event_task_id(event)
        if not task_id:
            continue
        data = event.get("extra_data") or event.get("object_data") or {}
        title = data.get("content") or data.get("item_content") or event.get("object_name")
        category = report_category(cache, {}, event)
        existing = context.setdefault(task_id, {})
        if title:
            existing["title"] = str(title)
        if category and category != "Unknown":
            existing["category"] = category
    return context


def report_category(cache, task, event):
    if task.get("project_id"):
        return project_name(cache, task.get("project_id"))
    project_id = event.get("parent_project_id")
    data = event.get("extra_data") or event.get("object_data") or {}
    if data.get("destination_project_id"):
        project_id = data.get("destination_project_id")
    if project_id:
        return project_name(cache, project_id)
    return "Unknown"


def skip_report_event(event, since, until):
    data = event.get("extra_data") or event.get("object_data") or {}
    if event.get("event_type") != "completed" or not data.get("is_recurring"):
        return False
    completed_due = parse_iso(data.get("completed_due_date"))
    if not completed_due:
        completed_due = parse_iso(data.get("completed_due_date_local"))
    if not completed_due:
        return False
    return not (since <= completed_due <= until)


def synthetic_task_from_event(event):
    data = event.get("extra_data") or event.get("object_data") or {}
    return {"content": event.get("object_name") or data.get("content") or data.get("item_content") or ""}


def event_task_id(event):
    if event.get("object_type") == "note" and event.get("parent_item_id"):
        return str(event.get("parent_item_id"))
    return str(event.get("object_id") or event.get("item_id") or event.get("parent_item_id") or "")


def activity_text(event):
    data = event.get("extra_data") or event.get("object_data") or {}
    for key in ("content", "note_content", "text", "item_content"):
        if data.get(key):
            return str(data[key])
    if event.get("event_type") == "completed":
        return "Completed"
    return str(event.get("event_type") or "")


def classify_activity(event, text):
    event_type = str(event.get("event_type") or "")
    object_type = str(event.get("object_type") or "")
    if event_type == "completed":
        return "Finished"
    if text.startswith("Done:"):
        return "Finished"
    if text.startswith("Waiting:"):
        return "Waiting"
    if text.startswith("Progress:") or text.startswith("Resumed:"):
        return "Progress"
    if "note" in object_type and text:
        return "Progress"
    return None


def load_runtime(readonly=False):
    cfg = Config.load()
    client = Todoist(cfg.token)
    cache = Cache.load()
    return cfg, client, cache


def load_cached_runtime(refresh=False):
    cfg = Config.load()
    cache = Cache.load()
    if refresh:
        client = Todoist(cfg.token)
        sync_readonly(client, cache)
    return cfg, cache


def build_parser():
    parser = argparse.ArgumentParser(
        prog="todo",
        description="Command-line helper for Todoist tasks.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  todo now
  todo task --add operations "Deliver release" "check dashboard table" "close build"
  todo rename "review" "send review"
  todo done "send review"
  todo step --done "Deliver release" "check dashboard table"
  todo task --wait "REVIEW-123" "waiting for review"
  todo report --final""",
    )
    parser.add_argument("--color", choices=("auto", "always", "never"), default="auto",
                        help="color output: auto, always, or never")
    sub = parser.add_subparsers(
        dest="cmd",
        metavar="COMMAND",
        title="commands",
        description="Run `todo COMMAND --help` for command-specific options.",
    )

    p = sub.add_parser(
        "init",
        help="initialize Todoist project, categories, label, and local config",
        description="Initialize or validate the Todoist project, default categories, waiting label, and local config.",
    )
    p.add_argument("--token", help="Todoist API token to store in ~/.todo/config")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser(
        "category",
        help="list or add categories",
        description="List categories, or create a category with --add NAME.",
    )
    p.add_argument("--add", "--create", metavar="NAME", help="category name to create")
    p.add_argument("--refresh", action="store_true", help="sync Todoist before listing categories")
    p.set_defaults(func=cmd_category)

    p = sub.add_parser(
        "rename",
        help="rename a task or step",
        description=RENAME_USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("values", nargs="*", help="ITEM NEW_NAME")
    p.set_defaults(func=cmd_rename_shortcut)

    p = sub.add_parser(
        "done",
        aliases=["close", "closed"],
        help="complete a task or step",
        description=DONE_USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("values", nargs="*", help="ITEM [TEXT]")
    p.set_defaults(func=cmd_done_shortcut)

    p = sub.add_parser(
        "unclose",
        aliases=["undone"],
        help="reopen a task or step",
        description=UNCLOSE_USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("values", nargs="*", help="ITEM")
    p.set_defaults(func=cmd_unclose_shortcut)

    p = sub.add_parser(
        "delete",
        help="delete a task or step",
        description=DELETE_USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--yes", action="store_true", help="skip delete confirmation")
    p.add_argument("values", nargs="*", help="ITEM")
    p.set_defaults(func=cmd_delete_shortcut)

    p = sub.add_parser(
        "wait",
        help="mark a task waiting",
        description=WAIT_USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--due", nargs="?", const=True, metavar="DATE", help="set waiting follow-up date")
    p.add_argument("values", nargs="*", help="TASK REASON")
    p.set_defaults(func=cmd_wait_shortcut)

    p = sub.add_parser(
        "move",
        help="move a task to a category",
        description=MOVE_USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("values", nargs="*", help="TASK CATEGORY")
    p.set_defaults(func=cmd_move_shortcut)

    p = sub.add_parser(
        "priority",
        help="set task priority",
        description=PRIORITY_USAGE,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("values", nargs="*", help="TASK P")
    p.set_defaults(func=cmd_priority_shortcut)

    p = sub.add_parser(
        "task",
        help="show or change tasks",
        description="""Show a task, or perform one task operation.

display:
  todo task TASK

modes:
  --add|--new|--create [--due DATE] [--reminder OFFSET] [-p1|-p2|-p3|-p4] CATEGORY TASK [STEP ...]
  --add|--new|--create --done|--close [--due DATE] [-p1|-p2|-p3|-p4] CATEGORY TASK [STEP ...]
  --done|--close TASK [TEXT]
  --undone|--unclose TASK
  --delete [--yes] TASK
  --wait|--waiting [--due DATE] TASK TEXT
  --resume TASK TEXT
  --due [--reminder OFFSET] TASK DATE
  --reminder OFFSET TASK
  --priority TASK P
  -p1|-p2|-p3|-p4 TASK
  --move TASK CATEGORY
  --rename TASK NEW_NAME
  --comment TASK TEXT [TEXT ...]
  --step TASK STEP [STEP ...]""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--add", "--new", "--create", dest="add", action="store_true",
                   help="create a task, optionally with initial steps")
    p.add_argument("--done", "--close", "--closed", dest="done", action="store_true",
                   help="complete a task, or add a completed task with --add")
    p.add_argument("--undone", "--unclose", dest="undone", action="store_true", help="reopen a completed task")
    p.add_argument("--delete", action="store_true", help="delete a task")
    p.add_argument("--yes", action="store_true", help="skip delete confirmation")
    p.add_argument("--wait", "--waiting", dest="wait", action="store_true", help="mark a task waiting")
    p.add_argument("--resume", action="store_true", help="clear waiting state")
    p.add_argument("--due", nargs="?", const=True, metavar="DATE",
                   help="set or clear attention date, set initial due date with --add, or set wait follow-up")
    p.add_argument("--reminder", action="append", metavar="OFFSET",
                   help="add relative reminder: 0, 10m, 2h, 1d, or 'at due'; repeat for multiple reminders")
    p.add_argument("--priority", action="store_true", help="set priority 1..4")
    p.add_argument("--move", action="store_true", help="move task to another category")
    p.add_argument("--rename", action="store_true", help="rename a task")
    p.add_argument("--comment", action="store_true", help="add one or more comments to a task")
    p.add_argument("--step", action="store_true", help="add one or more steps to a task")
    p.add_argument("--refresh", action="store_true", help="sync Todoist before showing a task")
    p.add_argument("-p1", dest="add_priority", action="store_const", const=1,
                   help="set priority 1, or set initial priority when adding a task")
    p.add_argument("-p2", dest="add_priority", action="store_const", const=2,
                   help="set priority 2, or set initial priority when adding a task")
    p.add_argument("-p3", dest="add_priority", action="store_const", const=3,
                   help="set priority 3, or set initial priority when adding a task")
    p.add_argument("-p4", dest="add_priority", action="store_const", const=4,
                   help="set priority 4, or set initial priority when adding a task")
    p.add_argument("values", nargs="*", help="arguments for the selected mode")
    p.set_defaults(func=cmd_task)

    p = sub.add_parser(
        "step",
        help="show or change task steps",
        description="""Show task steps, add steps, or mark one step done.

display:
  todo step TASK

modes:
  --add|--new|--create [--due DATE] [--reminder OFFSET] TASK STEP [STEP ...]
  --add|--new|--create --done|--close [--due DATE] TASK STEP [STEP ...]
  --done|--close TASK STEP
  --delete [--yes] TASK STEP
  --undone|--unclose TASK STEP
  --rename TASK STEP NEW_NAME
  --reminder OFFSET TASK STEP""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--add", "--new", "--create", dest="add", action="store_true", help="add one or more steps")
    p.add_argument("--done", "--close", "--closed", dest="done", action="store_true",
                   help="complete one existing step, or add completed steps with --add")
    p.add_argument("--undone", "--unclose", dest="undone", action="store_true", help="reopen one completed step")
    p.add_argument("--delete", action="store_true", help="delete one step")
    p.add_argument("--yes", action="store_true", help="skip delete confirmation")
    p.add_argument("--rename", action="store_true", help="rename one step")
    p.add_argument("--due", nargs="?", const=True, metavar="DATE", help="set initial due date with --add")
    p.add_argument("--reminder", action="append", metavar="OFFSET",
                   help="add relative reminder: 0, 10m, 2h, 1d, or 'at due'; repeat for multiple reminders")
    p.add_argument("--refresh", action="store_true", help="sync Todoist before showing steps")
    p.add_argument("values", nargs="*", help="arguments for the selected mode")
    p.set_defaults(func=cmd_step_noun)

    p = sub.add_parser(
        "comment",
        help="show, append, or edit task comment",
        description="""Show task comments, add comments, or edit all comments.

display:
  todo comment TASK

modes:
  TASK TEXT [TEXT ...]
  --add|--create TASK TEXT [TEXT ...]
  --edit TASK

--edit opens a bracket-form file with all comments. Remove an [id: ...]
header to delete that comment; if its body remains under the previous
comment, it is merged into that previous comment. Multiple [new] blocks create
multiple comments.""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--add", "--create", dest="add", action="store_true", help="create one comment per TEXT argument")
    p.add_argument("--edit", action="store_true", help="edit all comments in one file")
    p.add_argument("--refresh", action="store_true", help="sync Todoist before showing comments")
    p.add_argument("values", nargs="*", help="arguments for the selected mode")
    p.set_defaults(func=cmd_comment_noun)

    p = sub.add_parser(
        "search",
        help="search tasks, steps, and comments",
        description="Search tasks, descriptions, waiting reasons, steps, and comments.",
    )
    p.add_argument("--refresh", action="store_true", help="sync Todoist before searching the local cache")
    p.add_argument("values", nargs="*", help="search text")
    p.set_defaults(func=cmd_search)

    p = sub.add_parser(
        "now",
        help="show actionable tasks",
        description="Show open tasks outside hidden categories, including waiting tasks whose follow-up is due, sorted by due date and priority.",
    )
    p.add_argument("--refresh", action="store_true", help="sync Todoist before showing tasks")
    p.add_argument("--category", help="limit output to one category")
    p.set_defaults(func=cmd_now)

    p = sub.add_parser(
        "waiting",
        help="show waiting tasks",
        description="Show all waiting tasks.",
    )
    p.add_argument("--all", action="store_true", help="accepted for compatibility; waiting already shows all tasks")
    p.add_argument("--refresh", action="store_true", help="sync Todoist before showing waiting tasks")
    p.set_defaults(func=cmd_waiting)

    p = sub.add_parser(
        "someday",
        help="show hidden-category tasks",
        description="Show tasks in categories configured as hidden from `todo now`, such as Someday.",
    )
    p.add_argument("--refresh", action="store_true", help="sync Todoist before showing hidden-category tasks")
    p.set_defaults(func=cmd_someday)

    p = sub.add_parser(
        "report",
        help="generate weekly report draft",
        description="Generate a plain-text report from the report cursor to now, grouped by section and category.",
    )
    p.add_argument("--final", action="store_true", help="print the report and advance the report cursor to now")
    p.add_argument("--since", help="override report start timestamp")
    p.add_argument("--until", help="override report end timestamp")
    p.set_defaults(func=cmd_report)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    set_color_mode(args.color)
    if not hasattr(args, "func"):
        parser.print_help()
        return 0
    try:
        return args.func(args)
    except TodoUsage as e:
        print(str(e).rstrip(), file=sys.stderr)
        return 1
    except TodoError as e:
        print(f"todo: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("todo: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
